# Local dev overrides — copy to .env.local (not committed).
# cp .env.local.example .env.local

# ─── Infrastructure (localhost for pnpm dev, container hostnames for Docker) ──
DATABASE_URL=postgresql://aziru:aziru@localhost:5432/aziru
REDIS_URL=redis://localhost:6379
API_URL=http://localhost:3001

# ─── AI ───────────────────────────────────────────────────────────────────────
AI_PROVIDER=ollama
ENABLE_DEV_TOOLS=true

# Use Ollama for both LLM and embeddings in local dev
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
# Optional: use different Ollama models for routing vs. draft generation.
# Falls back to OLLAMA_MODEL if unset.
ROUTING_OLLAMA_MODEL=
DRAFT_OLLAMA_MODEL=
# qwen3-embedding is the recommended local embedding model (768-dim vectors).
# Pull it with: ollama pull qwen3-embedding
OLLAMA_EMBEDDING_MODEL=qwen3-embedding

FRONTIER_LLM_PROVIDER=gemini
FRONTIER_LLM_API_KEY=
FRONTIER_LLM_MODEL=gemini-2.0-flash
FRONTIER_LLM_BASE_URL=
# Optional: use different models for routing, draft, and taxonomy generation.
# Each falls back to FRONTIER_LLM_MODEL if unset. Keep TAXONOMY_LLM_MODEL on a
# capable tier (not the cheapest routing model) — cheap tiers 503 most often.
ROUTING_LLM_MODEL=
DRAFT_LLM_MODEL=
TAXONOMY_LLM_MODEL=

ALLOW_LOCAL_AI_IN_PRODUCTION=false

# ─── Dev tunnel (optional, real-time push) ────────────────────────────────────
# Stable hostname on a Cloudflare-hosted domain you own, one per developer.
# `pnpm dev` starts a Cloudflare tunnel on it exposing the local API (port 3001)
# so Gmail Pub/Sub and Microsoft Graph can push to local dev. Outlook push
# requires this (Graph subscriptions cannot be repointed after creation); leave
# unset to fall back to an ephemeral quick tunnel (Gmail push only).
#
# One-time setup (see "Real-time push in local dev" in the README):
#   cloudflared tunnel login
#   cloudflared tunnel create dev-yourname
#   cloudflared tunnel route dns dev-yourname dev-yourname.yourdomain.com
# DEV_TUNNEL_HOSTNAME=dev-yourname.yourdomain.com
# Cloudflare tunnel name. Defaults to the first label of DEV_TUNNEL_HOSTNAME.
# DEV_TUNNEL_NAME=dev-yourname
# Required for Outlook push: must match the tunnel hostname exactly.
# MS_GRAPH_NOTIFICATION_URL=https://dev-yourname.yourdomain.com/webhooks/outlook
# Set DEV_TUNNEL=0 to start `pnpm dev` without the tunnel.

# ─── Analytics (optional) ────────────────────────────────────────────────────
NEXT_PUBLIC_ANALYTICS_URL=

# ─── Stripe (sandbox) ─────────────────────────────────────────────────────────
# Use Stripe test mode keys from https://dashboard.stripe.com/test/apikeys
# Forward webhooks locally: pnpm stripe
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
# Test mode Price IDs — create in https://dashboard.stripe.com/test/products
STRIPE_PRICE_PRO_MONTHLY=price_
STRIPE_PRICE_PRO_ANNUAL=price_
STRIPE_PRICE_BUSINESS_MONTHLY=price_
STRIPE_PRICE_BUSINESS_ANNUAL=price_
