# Local dev overrides — copy to .env.local (not committed).
# cp .env.local.example .env.local

# ─── AI ───────────────────────────────────────────────────────────────────────
AI_PROVIDER=ollama
ENABLE_DEV_TOOLS=true

# Use Ollama for both LLM and embeddings in local dev
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
# qwen3-embedding is the recommended local embedding model (768-dim vectors).
# Pull it with: ollama pull qwen3-embedding
OLLAMA_EMBEDDING_MODEL=qwen3-embedding

FRONTIER_LLM_PROVIDER=openai
FRONTIER_LLM_API_KEY=
FRONTIER_LLM_MODEL=gpt-4o-mini
FRONTIER_LLM_BASE_URL=

ALLOW_LOCAL_AI_IN_PRODUCTION=false
