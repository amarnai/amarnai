#!/usr/bin/env bash
# Blocks commits that contain secrets or credential files.
set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

staged=$(git diff --cached --name-only)

# ── Blocked file patterns ──────────────────────────────────────────────────────
blocked_files=()
while IFS= read -r file; do
  case "$file" in
    # Env files — only .example variants are safe to commit
    .env|.env.*) [[ "$file" == *.example ]] || blocked_files+=("$file") ;;
    # Private keys and credential files
    *.pem|*.key|*.p12|*.pfx|*serviceAccountKey.json|*credentials.json)
      blocked_files+=("$file") ;;
  esac
done <<< "$staged"

if [[ ${#blocked_files[@]} -gt 0 ]]; then
  echo -e "${RED}[pre-commit] Blocked: credential or env file staged for commit:${NC}"
  for f in "${blocked_files[@]}"; do echo "  $f"; done
  exit 1
fi

# ── Secret pattern scan ────────────────────────────────────────────────────────
# Patterns: OpenAI keys, Stripe keys, generic high-entropy tokens
secret_pattern='(sk-[A-Za-z0-9]{20,}|pk_live_[A-Za-z0-9]+|rk_live_[A-Za-z0-9]+|whsec_[A-Za-z0-9]+|AIza[A-Za-z0-9_-]{35}|AKIA[A-Z0-9]{16})'

hits=$(git diff --cached -U0 | grep '^+' | grep -P "$secret_pattern" || true)
if [[ -n "$hits" ]]; then
  echo -e "${RED}[pre-commit] Blocked: staged diff appears to contain secrets:${NC}"
  echo -e "${YELLOW}$hits${NC}"
  echo "If this is a false positive, commit with --no-verify."
  exit 1
fi

# ── i18n: auto-translate on string-touching commits ───────────────────────────
# Runs only when staged files include translatable source (app/ui source dirs or
# existing catalogs). Skips cleanly when the AI provider is not configured so
# offline and keyless dev environments are never blocked.
i18n_dirs_pattern="^(apps/site/src|apps/web/src|apps/mobile/(app|src)|packages/ui/src|packages/i18n/src/locales)"
if echo "$staged" | grep -qE "$i18n_dirs_pattern"; then
  echo "[pre-commit] Translatable source changed — running i18n pipeline..."
  if ! pnpm i18n:extract; then
    echo -e "${RED}[pre-commit] i18n extract failed. Fix errors or commit with --no-verify.${NC}"
    exit 1
  fi
  # translate: non-fatal — missing provider skips gracefully (logs a warning).
  pnpm i18n:translate || true
  if ! pnpm i18n:compile; then
    echo -e "${RED}[pre-commit] i18n compile failed. Fix errors or commit with --no-verify.${NC}"
    exit 1
  fi
  # Stage any generated/updated catalog files so they're included in the commit.
  git add packages/i18n/src/locales/
fi

# ── Lint & typecheck ──────────────────────────────────────────────────────────
echo "[pre-commit] Running lint..."
if ! pnpm lint; then
  echo -e "${RED}[pre-commit] Lint failed. Fix errors or commit with --no-verify.${NC}"
  exit 1
fi

echo "[pre-commit] Running typecheck..."
if ! pnpm typecheck; then
  echo -e "${RED}[pre-commit] Typecheck failed. Fix errors or commit with --no-verify.${NC}"
  exit 1
fi

exit 0
