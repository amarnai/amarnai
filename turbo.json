{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "extract": {
      "outputs": ["src/locales/**/*.po"],
      "cache": false
    },
    "compile": {
      "dependsOn": ["extract"],
      "outputs": ["src/locales/**/*.mjs"]
    },
    "@amarnai/mobile#start": {
      "persistent": true,
      "cache": false
    },
    "@amarnai/mobile#android": {
      "persistent": true,
      "cache": false
    }
  }
}
