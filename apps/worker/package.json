{
  "name": "@aziru/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -e ../../.env -- node --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "repair-outlook-sent": "dotenv -e ../../.env.local -e ../../.env -- tsx src/scripts/repair-outlook-sent-messages.ts",
    "backfill-outlook-account-type": "dotenv -e ../../.env.local -e ../../.env -- tsx src/scripts/backfill-outlook-account-type.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aziru/ai": "workspace:*",
    "@aziru/auth": "workspace:*",
    "@aziru/billing": "workspace:*",
    "@aziru/config": "workspace:*",
    "@aziru/core": "workspace:*",
    "@aziru/db": "workspace:*",
    "@aziru/email": "workspace:*",
    "@aziru/gmail": "workspace:*",
    "@aziru/i18n": "workspace:*",
    "@aziru/mail": "workspace:*",
    "@aziru/queue": "workspace:*",
    "@aziru/shared": "workspace:*",
    "@lingui/core": "^6.4.0",
    "bullmq": "^5.77.3",
    "ioredis": "^5.11.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^3.0.0"
  }
}
