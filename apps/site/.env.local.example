# Copy to .env.local (not committed).
# cp apps/site/.env.local.example apps/site/.env.local

# URL of the Aziru web app — used to redirect pricing page CTAs.
# In production this is https://app.aziru.email.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Play Store listing URL for the Android app. The "download the app" banner
# is config-gated: leave unset until the listing is published and the banner
# stays hidden. Example: https://play.google.com/store/apps/details?id=com.aziru.app
# NEXT_PUBLIC_PLAY_STORE_URL=
