    "@amarnai/shared": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "bullmq": "^5.77.3",
    "hono": "^4.7.0",
    "ioredis": "^5.11.0",
    "tsx": "^4.19.0",
    "zod": "^3.25.0"
