{
  "name": "@amarnai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,tunnel -c cyan,yellow \"pnpm dev:server\" \"pnpm dev:tunnel\"",
    "dev:server": "dotenv -e ../../.env.local -e ../../.env -- node --import tsx --watch src/index.ts",
    "dev:tunnel": "node ../../scripts/dev-tunnel.mjs --if-configured",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@amarnai/ai": "workspace:*",
    "@amarnai/auth": "workspace:*",
    "@amarnai/billing": "workspace:*",
    "@amarnai/i18n": "workspace:*",
    "@amarnai/config": "workspace:*",
    "@amarnai/core": "workspace:*",
    "@amarnai/db": "workspace:*",
    "@amarnai/email": "workspace:*",
    "@amarnai/gmail": "workspace:*",
    "@amarnai/mail": "workspace:*",
    "@amarnai/outlook": "workspace:*",
    "@amarnai/queue": "workspace:*",
    "@amarnai/shared": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "bullmq": "^5.77.3",
    "hono": "^4.7.0",
    "ioredis": "^5.11.0",
    "tsx": "^4.19.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.4",
    "vitest": "^3.0.0"
  }
}
