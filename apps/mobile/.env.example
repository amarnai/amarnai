# Optional. Base URL of the Amarnai API the app talks to.
#
# Leave UNSET for local development on a physical device or emulator: the app
# automatically reuses the Metro dev-server host (your dev machine's LAN IP) on
# port 3001, so a phone in Expo Go reaches your local API with no config.
#
# Set this only to override that, e.g. an ngrok/Expo tunnel, staging, or prod:
#   EXPO_PUBLIC_API_URL=https://api.example.com
#
# Note: do NOT use http://localhost here for a physical device — localhost is the
# phone itself, not your dev machine.
# EXPO_PUBLIC_API_URL=
