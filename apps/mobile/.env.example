# ─── Google OAuth (native mobile client) ─────────────────────────────────────
# Client ID for the Android/iOS installed-app OAuth client created in Google
# Cloud Console. This is a public client (no secret). Required for "Continue
# with Google" sign-in and the in-app Gmail connect flow.
# Create at: console.cloud.google.com → APIs & Services → Credentials →
#   + Create Credentials → OAuth client ID → Application type: Android
# Package name: com.amarnai.app  SHA-1: your debug or release keystore fingerprint
EXPO_PUBLIC_GOOGLE_MOBILE_CLIENT_ID=

# ─── API ──────────────────────────────────────────────────────────────────────
# Base URL of the Amarnai API the app talks to.
#
# Expo Go (dev): leave UNSET. The app reads the Metro dev-server host (your
# dev machine's LAN IP) from expo-constants and points the API at port 3001,
# so a phone on the same network reaches your local API with no config.
#
# Standalone builds (APK/AAB, EAS Build, app icon): MUST be set. Metro host
# detection does not run in production bundles, so without this the app falls
# back to http://localhost:3001 (the phone itself) and all API calls fail.
#   - Local build: use your machine's LAN IP, e.g. http://192.168.1.10:3001
#   - Tunnel: your ngrok/Expo tunnel URL
#   - Staging/prod: https://api.example.com
#
# Note: do NOT use http://localhost for a physical device — localhost is the
# phone itself, not your dev machine.
# EXPO_PUBLIC_API_URL=
