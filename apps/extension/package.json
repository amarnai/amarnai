{
  "name": "@amarnai/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @amarnai/i18n compile",
    "build": "vite build --mode development && vite build -c vite.sw.config.ts --mode development",
    "prebuild:prod": "pnpm --filter @amarnai/i18n compile",
    "build:prod": "vite build --mode production && vite build -c vite.sw.config.ts --mode production",
    "package": "pnpm build:prod && rm -f amarnai-extension.zip && cd dist && zip -r ../amarnai-extension.zip .",
    "dev": "vite build --watch --mode development",
    "dev:sw": "vite build --watch -c vite.sw.config.ts --mode development",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@amarnai/api-client": "workspace:*",
    "@amarnai/core": "workspace:*",
    "@amarnai/i18n": "workspace:*",
    "@amarnai/shared": "workspace:*",
    "@amarnai/tokens": "workspace:*",
    "@amarnai/ui": "workspace:*",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@lingui/core": "^6.4.0",
    "@lingui/react": "^6.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^6.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
