# Copy to .env. Vite loads it in every mode, so the same values apply to both
# `pnpm dev` and `pnpm build`. VITE_-prefixed vars are inlined at build time.

# API origin. MUST also appear in manifest.json host_permissions.
VITE_API_URL=http://localhost:3001

# Marketing/web app origin, for sign-up + connect-Gmail links out of the panel.
VITE_WEB_APP_URL=http://localhost:3000

# Google OAuth *Web* client id (the same confidential client the API redeems
# codes against via AUTH_GOOGLE_ID). Needed for the "Sign in with Google" button.
VITE_GOOGLE_WEB_CLIENT_ID=
