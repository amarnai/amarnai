# Copy to .env for dev/watch. `vite build` defaults to production mode, so a
# real store build reads .env.production. VITE_-prefixed vars are inlined into
# the bundle at build time.

# API origin. host_permissions in the manifest is DERIVED from this at build
# time (see manifest.config.ts), so there is nothing to keep in sync by hand.
# Must be https for a store build (Chrome rejects http:// host permissions).
VITE_API_URL=http://localhost:3001

# Marketing/web app origin, for sign-up + connect-Gmail links out of the panel.
VITE_WEB_APP_URL=http://localhost:3000

# Google OAuth *Web* client id (the same confidential client the API redeems
# codes against via AUTH_GOOGLE_ID). Needed for the "Sign in with Google" button.
VITE_GOOGLE_WEB_CLIENT_ID=

# Microsoft (Entra) app registration client id — the SAME confidential Web client
# the API redeems Outlook codes against via MS_GRAPH_CLIENT_ID. Leave empty to
# hide the "Connect Outlook" option. The extension redirect URI
# (https://<ext-id>.chromiumapp.org/, or the Firefox equivalent) must be
# registered on that app registration under the "Web" platform.
VITE_MS_CLIENT_ID=

# InboxSDK application id, used by the Gmail content script to render the
# "Amarnai Reply" button inside Gmail's own compose. Not a secret (it ships in
# the bundle), but self-hosters should register their own at inboxsdk.com rather
# than reuse Amarnai's. Leave empty to build without the reply button; the
# thread-summary injection is unaffected either way.
VITE_INBOXSDK_APP_ID=

# OPTIONAL, prod only: base64 DER public key that pins a stable extension ID.
# When set, it is injected into the manifest as the top-level "key". Generate it
# once from key.pem (see README "Deployment prerequisites"); never commit it.
EXTENSION_KEY=
