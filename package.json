{
  "name": "amarnai",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "mobile": "pnpm --filter @amarnai/mobile start",
    "mobile:android": "pnpm --filter @amarnai/mobile android",
    "mobile:build": "pnpm --filter @amarnai/mobile build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:sorting": "pnpm --filter @amarnai/ai test:sorting",
    "db:generate": "pnpm --filter @amarnai/db generate",
    "db:migrate": "pnpm --filter @amarnai/db migrate",
    "db:seed": "pnpm --filter @amarnai/db seed",
    "db:reset": "pnpm --filter @amarnai/db reset",
    "embeddings:refresh-taxonomy": "pnpm --filter @amarnai/db embeddings:refresh-taxonomy",
    "stripe": "stripe listen --forward-to localhost:3000/api/billing/webhook",
    "i18n": "pnpm i18n:extract && pnpm i18n:translate && pnpm i18n:compile",
    "i18n:extract": "pnpm --filter @amarnai/i18n extract",
    "i18n:translate": "node scripts/i18n-translate.mjs",
    "i18n:compile": "pnpm --filter @amarnai/i18n compile",
    "tunnel": "node scripts/gmail-tunnel.mjs",
    "configure:pubsub": "node scripts/configure-pubsub.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.0.0",
    "openai": "^4.100.0",
    "turbo": "^2.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "zod": "^3.25.76"
  },
  "packageManager": "pnpm@11.3.0"
}
