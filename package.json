{
  "name": "aziru",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Azgard LLC",
  "scripts": {
    "dev": "turbo dev",
    "mobile": "pnpm --filter @aziru/mobile start",
    "mobile:android": "pnpm --filter @aziru/mobile android",
    "mobile:build": "pnpm --filter @aziru/mobile build",
    "extension:build": "pnpm --filter @aziru/extension build",
    "extension:build:prod": "pnpm --filter @aziru/extension build:prod",
    "extension:package": "pnpm --filter @aziru/extension package",
    "extension:build:firefox": "pnpm --filter @aziru/extension build:firefox",
    "extension:build:prod:firefox": "pnpm --filter @aziru/extension build:prod:firefox",
    "extension:package:firefox": "pnpm --filter @aziru/extension package:firefox",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:sorting": "pnpm --filter @aziru/ai test:sorting",
    "db:generate": "pnpm --filter @aziru/db generate",
    "db:migrate": "pnpm --filter @aziru/db migrate",
    "db:seed": "pnpm --filter @aziru/db seed",
    "db:reset": "pnpm --filter @aziru/db reset",
    "embeddings:refresh-taxonomy": "pnpm --filter @aziru/db embeddings:refresh-taxonomy",
    "stripe": "stripe listen --forward-to localhost:3000/api/billing/webhook",
    "i18n": "pnpm i18n:extract && pnpm i18n:translate && pnpm i18n:compile",
    "i18n:extract": "pnpm --filter @aziru/i18n extract",
    "i18n:translate": "node scripts/i18n-translate.mjs",
    "i18n:compile": "pnpm --filter @aziru/i18n compile",
    "tunnel": "node scripts/dev-tunnel.mjs",
    "configure:pubsub": "node scripts/configure-pubsub.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.0.0",
    "openai": "^4.100.0",
    "turbo": "^2.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "zod": "^3.25.76"
  },
  "packageManager": "pnpm@11.3.0"
}
