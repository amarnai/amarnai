# Self-hosting configuration for docker-compose.selfhost.yml
# Copy this to .env and fill in the values marked <required>.
# cp .env.selfhost.example .env

# ─── Postgres ────────────────────────────────────────────────────────────────
# "postgres" is the Docker service name — do not change to localhost.
DATABASE_URL=postgresql://amarnai:amarnai@postgres:5432/amarnai
POSTGRES_USER=amarnai
POSTGRES_PASSWORD=amarnai
POSTGRES_DB=amarnai

# ─── Redis ────────────────────────────────────────────────────────────────────
# "redis" is the Docker service name — do not change to localhost.
REDIS_URL=redis://redis:6379
# Optional: dedicated Redis for the best-effort AI cache (embedding vectors), so
# it can never evict BullMQ job data under memory pressure. When unset, the
# cache shares REDIS_URL; in that case configure Redis with
# maxmemory-policy volatile-lru (the cache always sets a TTL, BullMQ keys do not).
# AI_CACHE_REDIS_URL=redis://redis-aicache:6379

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001
# Internal URL used by the web container to call the API (Docker service name).
API_URL=http://api:3001

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_PORT=3002
INBOX_SYNC_INTERVAL_MS=300000

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=<required>
# Set to your public-facing URL (e.g. https://mail.yourdomain.com).
AUTH_URL=http://localhost:3000
# <required> — from Google Cloud Console (see README)
AUTH_GOOGLE_ID=<required>
AUTH_GOOGLE_SECRET=<required>
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=<required>
# Signs per-user access tokens for native clients (mobile).
# Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=<required>
# Optional: set true to disable per-IP rate limiting on /auth/* if you throttle
# at the reverse proxy. Defaults to false (rate limiting on).
AUTH_RATE_LIMIT_DISABLED=false

# ─── AI ───────────────────────────────────────────────────────────────────────
AI_PROVIDER=frontier
ENABLE_DEV_TOOLS=false

# LLM
FRONTIER_LLM_PROVIDER=openai
FRONTIER_LLM_API_KEY=<required>
FRONTIER_LLM_MODEL=gpt-4o-mini
FRONTIER_LLM_BASE_URL=

# Embeddings
# FRONTIER_EMBEDDING_PROVIDER: "gemini" (default), "openai", or any OpenAI-compatible provider
# Gemini: get a key at https://aistudio.google.com/apikey
# OpenAI: set FRONTIER_EMBEDDING_PROVIDER=openai and FRONTIER_EMBEDDING_MODEL=text-embedding-3-small
# Custom endpoint: set FRONTIER_EMBEDDING_BASE_URL for any OpenAI-compatible API
EMBEDDING_PROVIDER=frontier
FRONTIER_EMBEDDING_PROVIDER=gemini
FRONTIER_EMBEDDING_API_KEY=<required>
FRONTIER_EMBEDDING_MODEL=gemini-embedding-001
FRONTIER_EMBEDDING_BASE_URL=
# Output vector size. Recommended 768; omit to use the model default. Use the same
# model + dimensions everywhere you embed (API, worker, and when you run
# `pnpm embeddings:refresh-taxonomy`) — changing either re-embeds all vectors.
FRONTIER_EMBEDDING_DIMENSIONS=768

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set to your public-facing URL (must match AUTH_URL).
CORS_ORIGIN=http://localhost:3000

# ─── Gmail OAuth ──────────────────────────────────────────────────────────────
# Replace localhost:3000 with your public-facing URL in production.
GMAIL_OAUTH_CALLBACK_URL=http://localhost:3000/api/gmail/callback
# AES-256-GCM key for stored OAuth refresh tokens (Gmail + Outlook share it).
# Generate with: openssl rand -hex 32 — startup fails without a valid 64-hex key.
TOKEN_ENCRYPTION_KEY=<required>

# ─── Mail providers ───────────────────────────────────────────────────────────
# Providers offered in the UI, comma-separated. Add "outlook" once the Microsoft
# app registration below is configured. Default: gmail.
MAIL_PROVIDERS=gmail

# Folder→label writeback (Gmail labels / Outlook categories). When enabled, the
# write scope is requested UPFRONT at sign-in/connect and writeback is ON by
# default per workspace (switch-off available; declining the permission degrades
# to read-only). Self-hosters bringing their own OAuth app must add
# gmail.modify / Mail.ReadWrite to their consent screen before enabling.
LABEL_WRITEBACK_ENABLED=false

# ─── Outlook Add-in (Amarnai Reply button inside Outlook) ─────────────────────
# Serves /outlook-manifest.xml and the /outlook-panel task pane. OFF by default:
# enabling it lets Outlook's hosts frame the pane route (see frame-ancestors in
# apps/web/src/lib/csp.ts). Every other route stays unframable either way.
OUTLOOK_ADDIN_ENABLED=false

# The public origin apps/web is reachable at. Outlook resolves every add-in
# resource by absolute URL, so the manifest is templated with this. Must be
# https and publicly reachable for a real Outlook install (sideloading from
# localhost works only for local development).
APP_BASE_URL=http://localhost:3000

# REQUIRED if you enable the add-in above. The add-in's identity, as a UUID.
# Outlook keys installed add-ins by it, so leaving this at Amarnai's default
# means your add-in and Amarnai's hosted one cannot both be installed in the
# same mailbox: whichever is installed second silently replaces the other.
# Generate your own once with `uuidgen`.
#
# It must NEVER change once you have distributed the manifest to your users: to
# Outlook a new id is a different add-in, and every existing install goes stale.
# OUTLOOK_ADDIN_ID=

# ─── Outlook / Microsoft Graph (read-only, optional) ──────────────────────────
# Confidential Web app registration (Microsoft Entra), multitenant + personal.
# Set CLIENT_ID + CLIENT_SECRET together to enable Outlook. TENANT is "common".
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT=common
# Generate with: openssl rand -hex 32
MS_GRAPH_SUBSCRIPTION_SECRET=
# Public HTTPS webhook URL for Graph push. Leave blank for polling-only self-host
# (no public endpoint). Requires MS_GRAPH_SUBSCRIPTION_SECRET when set.
MS_GRAPH_NOTIFICATION_URL=
OUTLOOK_OAUTH_CALLBACK_URL=http://localhost:3000/api/outlook/callback

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_FROM=noreply@yourdomain.com
# Option A: Resend HTTP API (recommended — avoids SMTP port blocking on most cloud hosts).
# When set, SMTP variables below are ignored. Get a key at https://resend.com
RESEND_API_KEY=
# Option B: SMTP (use your own mail server instead of Resend).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set to true when using port 465 (direct SSL). Leave unset for port 587 (STARTTLS).
SMTP_SECURE=
