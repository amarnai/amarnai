# Copy this file to .env and fill in the values.
# cp .env.example .env
# For local overrides, copy .env.local.example to .env.local (not committed).

# ─── Postgres ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://genizor:genizor@localhost:5432/genizor
POSTGRES_USER=genizor
POSTGRES_PASSWORD=genizor
POSTGRES_DB=genizor

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_PORT=3002

# ─── Auth ─────────────────────────────────────────────────────────────────────
SESSION_SECRET=

# ─── AI ───────────────────────────────────────────────────────────────────────
AI_PROVIDER=mock
ENABLE_DEV_TOOLS=false

FRONTIER_LLM_PROVIDER=openai
FRONTIER_LLM_API_KEY=
FRONTIER_LLM_MODEL=
FRONTIER_LLM_BASE_URL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
ALLOW_LOCAL_AI_IN_PRODUCTION=false

# ─── Gmail OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
