# Copy this file to .env and fill in the values.
# cp .env.example .env

# ─── Postgres ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://genizor:genizor@localhost:5432/genizor
POSTGRES_USER=genizor
POSTGRES_PASSWORD=genizor
POSTGRES_DB=genizor

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_PORT=3002

# ─── Auth ─────────────────────────────────────────────────────────────────────
SESSION_SECRET=

# ─── AI (not wired yet) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Gmail OAuth (not wired yet) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
