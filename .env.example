# Copy this file to .env and fill in the values.
# cp .env.example .env
# For local overrides, copy .env.local.example to .env.local (not committed).

# ─── Postgres ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://genizor:genizor@localhost:5432/genizor
POSTGRES_USER=genizor
POSTGRES_PASSWORD=genizor
POSTGRES_DB=genizor

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_PORT=3002

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Required: generate with `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Used by server actions to authenticate calls to the Hono API
# generate with `openssl rand -hex 32`
INTERNAL_API_SECRET=

# ─── AI ───────────────────────────────────────────────────────────────────────
AI_PROVIDER=mock
ENABLE_DEV_TOOLS=false

FRONTIER_LLM_PROVIDER=openai
FRONTIER_LLM_API_KEY=
FRONTIER_LLM_MODEL=
FRONTIER_LLM_BASE_URL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
ALLOW_LOCAL_AI_IN_PRODUCTION=false

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Gmail OAuth ──────────────────────────────────────────────────────────────
# Callback URL for Gmail inbox authorization (not the NextAuth callback).
# Must be registered as an authorised redirect URI in Google Cloud Console.
GMAIL_OAUTH_CALLBACK_URL=http://localhost:3000/api/gmail/callback
# AES-256-GCM key for encrypting stored Gmail refresh tokens.
# Generate with: openssl rand -hex 32
# If unset, the key is derived from AUTH_SECRET (dev only — always set this in production).
GMAIL_TOKEN_ENCRYPTION_KEY=

# ─── Gmail Debug Tools ────────────────────────────────────────────────────────
# Set to true to show the Gmail Sort Tester panel on the settings page.
# Only renders when a Gmail inbox is connected. Never enable in production.
NEXT_PUBLIC_ENABLE_GMAIL_DEBUG_TOOLS=false
