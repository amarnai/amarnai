# Copy this file to .env and fill in the values.
# cp .env.example .env
# For local overrides, copy .env.local.example to .env.local (not committed).

# ─── Postgres ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://amarnai:amarnai@localhost:5432/amarnai
# Max Prisma connections opened per process. Leave unset for Prisma's default
# (dev/self-host). In hosted/multi-service deploys set it explicitly so that
# (sum of replicas across all services) x limit stays under Postgres
# max_connections, with headroom for rolling-deploy overlap.
# DB_CONNECTION_LIMIT=5
POSTGRES_USER=amarnai
POSTGRES_PASSWORD=amarnai
POSTGRES_DB=amarnai

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Optional: dedicated Redis for the best-effort AI cache (embedding vectors).
# Point this at a separate instance in production so the cache can never evict
# BullMQ job data under memory pressure. When unset, the cache shares REDIS_URL;
# in that case set that instance's maxmemory-policy to volatile-lru.
# AI_CACHE_REDIS_URL=redis://localhost:6380

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001

# ─── Worker ───────────────────────────────────────────────────────────────────
WORKER_PORT=3002
# Polling interval as a fallback when push notifications are not configured (ms).
# Default: 300000 (5 minutes). When GMAIL_PUBSUB_TOPIC is set, push handles
# real-time delivery and this only acts as a safety net for missed events.
INBOX_SYNC_INTERVAL_MS=300000

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Required: generate with `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Confidential Web OAuth client (id + secret). Used by the web sign-in/connect
# flow and to redeem the mobile app's serverAuthCode. All Gmail refresh tokens
# are minted against this client so the worker/API can refresh them server-side.
# The mobile app sets EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID to this same id.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Used by server actions to authenticate calls to the Hono API
# generate with `openssl rand -hex 32`
INTERNAL_API_SECRET=
# Signs per-user access tokens for native clients (mobile). Distinct from the
# secrets above. generate with `openssl rand -hex 32`
AUTH_JWT_SECRET=
# Set to true to disable per-IP rate limiting on /auth/* (e.g. if you throttle
# at the proxy). Leave unset/false to keep it on.
AUTH_RATE_LIMIT_DISABLED=

# Number of trusted reverse proxies in front of the app. Controls how the client
# IP is derived for rate limiting (both the API's /auth/* limits and the web
# sign-in/register/forgot-password limits).
#   0: ignore X-Forwarded-For / X-Real-IP and use the socket address. Correct ONLY
#     when clients connect to the app directly.
#   1, 2, ...: read the client IP from the X-Forwarded-For entry that many hops
#     from the right, trusting exactly that many of your own proxies and ignoring
#     everything to their left (which the client can forge). Use 1 behind a single
#     reverse proxy (e.g. nginx/Caddy), 2 behind a CDN + reverse proxy, etc.
# REQUIRED IN PRODUCTION: the app refuses to start with NODE_ENV=production unless
# this is set, so a misconfiguration cannot silently make every user share ONE
# rate-limit bucket (behind a load balancer that throttles everyone out of login).
# If you run behind a proxy but set 0, that footgun returns; set your ACTUAL hop
# count. Setting it higher than your real hop count lets clients spoof their IP to
# dodge limits, so match it exactly. Outside production an unset value means 0.
TRUST_PROXY=0

# ─── AI ───────────────────────────────────────────────────────────────────────
AI_PROVIDER=mock
ENABLE_DEV_TOOLS=false

# LLM (frontier)
FRONTIER_LLM_PROVIDER=openai
FRONTIER_LLM_API_KEY=
FRONTIER_LLM_MODEL=gpt-4o-mini
FRONTIER_LLM_BASE_URL=
# Optional: use different models for routing, draft, summary, and taxonomy generation.
# Each falls back to FRONTIER_LLM_MODEL if unset. Keep TAXONOMY_LLM_MODEL on a
# capable tier (not the cheapest routing model): the cheap tiers are the most
# demand-throttled and routinely 503 on this one-shot, user-facing generation.
ROUTING_LLM_MODEL=
DRAFT_LLM_MODEL=
SUMMARY_LLM_MODEL=
TAXONOMY_LLM_MODEL=
# Reasoning effort per feature: low | medium | high | none (default none).
# Thread summaries are two sentences and do not benefit from thinking.
SUMMARY_REASONING_EFFORT=

# Embeddings — set to "frontier" in production, "ollama" for local dev
EMBEDDING_PROVIDER=frontier

# Frontier embeddings (production)
# FRONTIER_EMBEDDING_PROVIDER: which API to call — "gemini" (default) or any OpenAI-compatible provider
# Gemini: https://aistudio.google.com/apikey  — gemini-embedding-001 is $0.15/1M tokens (free within quota)
# OpenAI: use "openai", set FRONTIER_EMBEDDING_MODEL=text-embedding-3-small
# Custom OpenAI-compatible endpoint: set FRONTIER_EMBEDDING_BASE_URL
FRONTIER_EMBEDDING_PROVIDER=gemini
FRONTIER_EMBEDDING_API_KEY=
FRONTIER_EMBEDDING_MODEL=gemini-embedding-001
FRONTIER_EMBEDDING_BASE_URL=
# FRONTIER_EMBEDDING_DIMENSIONS: output vector size. Recommended 768 (4x smaller
# storage/compute than the 3072 default, minimal quality loss). Omit to use the
# model default. Use the same model + dimensions everywhere you embed (API,
# worker, and when you run `pnpm embeddings:refresh-taxonomy`) — changing either
# re-embeds all stored vectors.
FRONTIER_EMBEDDING_DIMENSIONS=768

# Ollama (local dev only — do not use in production)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
# Optional: use different Ollama models for routing, draft, and summary generation.
# Falls back to OLLAMA_MODEL if unset.
ROUTING_OLLAMA_MODEL=
DRAFT_OLLAMA_MODEL=
SUMMARY_OLLAMA_MODEL=
# qwen3-embedding is the recommended local embedding model (768-dim vectors).
# Pull it with: ollama pull qwen3-embedding
OLLAMA_EMBEDDING_MODEL=qwen3-embedding
ALLOW_LOCAL_AI_IN_PRODUCTION=false

# ─── Usage quotas ─────────────────────────────────────────────────────────────
# Set to "false" to lift the per-plan monthly caps (self-hosted deployments that
# manage their own AI spend). Usage is still recorded either way.
ENFORCE_SUMMARY_QUOTA=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Gmail Push Notifications (optional) ──────────────────────────────────────
# Enables real-time inbox sync via Google Cloud Pub/Sub instead of polling.
# When set, Gmail pushes a notification the moment a message arrives, and
# Amarnai enqueues a sync job immediately (near-zero latency).
#
# One-time GCP setup (shared between all environments):
#   1. Create a GCP project and enable the Gmail API and Pub/Sub API.
#   2. Create a Pub/Sub topic, e.g. "amarnai-gmail-push".
#   3. Grant the Gmail service account publish rights:
#      gcloud pubsub topics add-iam-policy-binding amarnai-gmail-push \
#        --member="serviceAccount:gmail-api-push@system.gserviceaccount.com" \
#        --role="roles/pubsub.publisher"
#   4. Create two subscriptions — one for production, one for local dev:
#      gcloud pubsub subscriptions create amarnai-gmail-sub \
#        --topic=amarnai-gmail-push --ack-deadline=30
#      gcloud pubsub subscriptions create amarnai-gmail-sub-dev \
#        --topic=amarnai-gmail-push --ack-deadline=30
#      (Leave push endpoints unset; each environment configures its own below.)
#
# Production: after deploying, point the subscription at your API once:
#   API_URL=https://api.yourdomain.com pnpm configure:pubsub
#   Re-run whenever the API URL changes.
#
# Local dev: `pnpm dev` starts a Cloudflare tunnel and points the
#   amarnai-gmail-sub-dev subscription at it. See DEV_TUNNEL_HOSTNAME below.
#
# GMAIL_PUBSUB_TOPIC format: "projects/<project-id>/topics/<topic-name>"
GMAIL_PUBSUB_TOPIC=
# Random secret included as ?token= in the push endpoint URL.
# Generate with: openssl rand -hex 32
GMAIL_PUBSUB_WEBHOOK_SECRET=
# Pub/Sub subscription name that receives push notifications.
# Production default: amarnai-gmail-sub
# Local dev default:  amarnai-gmail-sub-dev (set in .env.local, used by pnpm tunnel)
GMAIL_PUBSUB_SUBSCRIPTION=amarnai-gmail-sub
# Base URL of this API instance — used by `pnpm configure:pubsub` to build
# the push endpoint. Not read at runtime by the API itself.
API_URL=https://api.yourdomain.com

# ─── Local dev tunnel ─────────────────────────────────────────────────────────
# Local dev only. Stable hostname on a Cloudflare-hosted domain you own, used by
# the tunnel that `pnpm dev` starts to expose the local API (port 3001) to Gmail
# Pub/Sub and Microsoft Graph. Set it in .env.local, one hostname per developer.
#
# Outlook needs this: Graph bakes the notification URL into each subscription at
# creation and cannot be repointed afterwards, so an ephemeral quick-tunnel URL
# will not do. Leave unset to fall back to a quick tunnel (Gmail push only).
#
# One-time setup, then set MS_GRAPH_NOTIFICATION_URL to https://<host>/webhooks/outlook:
#   cloudflared tunnel login
#   cloudflared tunnel create dev-yourname
#   cloudflared tunnel route dns dev-yourname dev-yourname.yourdomain.com
# DEV_TUNNEL_HOSTNAME=dev-yourname.yourdomain.com
# Cloudflare tunnel name. Defaults to the first label of DEV_TUNNEL_HOSTNAME.
# DEV_TUNNEL_NAME=dev-yourname
# Set DEV_TUNNEL=0 to start `pnpm dev` without the tunnel.

# ─── Gmail OAuth ──────────────────────────────────────────────────────────────
# Callback URL for Gmail inbox authorization (not the NextAuth callback).
# Must be registered as an authorised redirect URI in Google Cloud Console.
GMAIL_OAUTH_CALLBACK_URL=http://localhost:3000/api/gmail/callback
# AES-256-GCM key for encrypting stored OAuth refresh tokens at rest, for every
# provider (Gmail and Outlook share one key). 64 hex chars = 32 bytes.
# Generate with: openssl rand -hex 32
# REQUIRED in production: there is no fallback. Startup fails if it is missing or
# not 64 hex chars. Left blank here, dev/tests use a fixed built-in dev key.
TOKEN_ENCRYPTION_KEY=

# ─── Mail providers ───────────────────────────────────────────────────────────
# Which mail providers are offered in the UI/connect flows, comma-separated.
# The runtime adapter is always chosen per connection; this only gates onboarding.
# Default: gmail (add "outlook" once the Microsoft app registration below is set).
MAIL_PROVIDERS=gmail

# Folder→label writeback: mirror taxonomy folders into the mailbox as Gmail
# labels / Outlook categories and keep them in sync as threads are sorted.
# When enabled, the write scope (gmail.modify / Mail.ReadWrite) is requested
# UPFRONT at Google sign-in and inbox connect, and writeback is ON by default
# per workspace (users can switch it off; declining the permission degrades to
# read-only). Keep OFF in production until Google's verification of
# gmail.modify is approved, or every sign-in shows the unverified-scope warning.
LABEL_WRITEBACK_ENABLED=false

# ─── Outlook Add-in (Amarnai Reply button inside Outlook) ─────────────────────
# Serves /outlook-manifest.xml and the /outlook-panel task pane. OFF by default:
# enabling it lets Outlook's hosts frame the pane route (see frame-ancestors in
# apps/web/src/lib/csp.ts). Every other route stays unframable either way.
OUTLOOK_ADDIN_ENABLED=false

# The public origin apps/web is reachable at. Outlook resolves every add-in
# resource by absolute URL, so the manifest is templated with this. Must be
# https and publicly reachable for a real Outlook install (sideloading from
# localhost works only for local development).
APP_BASE_URL=http://localhost:3000

# The add-in's identity, as a UUID. Outlook keys installed add-ins by it, so two
# deployments that share one cannot coexist in a mailbox: installing the second
# silently replaces the first. Leave unset to use Amarnai's own id. Set your own
# (generate with `uuidgen`) for a self-host, and for any staging environment that
# has the add-in enabled alongside production.
#
# It must NEVER change once you have published or distributed the manifest: to
# Outlook a new id is a different add-in, and every existing install goes stale.
# OUTLOOK_ADDIN_ID=

# ─── Outlook / Microsoft Graph (read-only) ────────────────────────────────────
# Confidential Web app registration (Microsoft Entra). Supported account types:
# "Accounts in any organizational directory (multitenant) and personal Microsoft
# accounts", so the authority/tenant is the literal string "common". Delegated
# scopes: Mail.Read offline_access User.Read (none need admin consent).
# Setting CLIENT_ID + CLIENT_SECRET together enables the Outlook provider, which
# also turns on "Continue with Microsoft" on the web sign-in page and in the
# extension panel.
#
# ONE app registration serves every Microsoft flow, so all of these redirect URIs
# must be registered on it (that shared secret is what lets the worker refresh a
# sign-in-issued token):
#   https://<web-host>/api/auth/callback/microsoft-entra-id   (web sign-in)
#   http://localhost:3000/api/auth/callback/microsoft-entra-id (local dev)
#   https://<web-host>/api/outlook/callback                    (connect an inbox)
#   https://<extension-id>.chromiumapp.org/                    (Chrome extension)
#   https://<hash>.extensions.allizom.org/                     (Firefox extension)
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# The literal "common" for the multitenant + personal account type (not a GUID).
MS_GRAPH_TENANT=common
# clientState secret echoed on every Graph change-notification, so the webhook can
# verify a subscription callback is genuinely ours. Generate: openssl rand -hex 32
MS_GRAPH_SUBSCRIPTION_SECRET=
# Public HTTPS URL Graph posts change notifications to (the Outlook analogue of
# GMAIL_PUBSUB_TOPIC). When unset or non-HTTPS, Outlook runs polling-only.
# Requires MS_GRAPH_SUBSCRIPTION_SECRET. e.g. https://api.amarnai.com/webhooks/outlook
# Local dev: https://<DEV_TUNNEL_HOSTNAME>/webhooks/outlook (never localhost —
# Graph rejects non-HTTPS URLs, and the API listens on 3001, not 3000).
MS_GRAPH_NOTIFICATION_URL=
# Redirect URI registered for the confidential Web app; must match exactly.
OUTLOOK_OAUTH_CALLBACK_URL=http://localhost:3000/api/outlook/callback

# ─── Email ────────────────────────────────────────────────────────────────────
# Sender address for verification and password reset emails.
EMAIL_FROM=noreply@amarnai.com
# Option A: Resend HTTP API (recommended for hosted deployments — avoids SMTP port blocking).
# When set, SMTP variables below are ignored. Get a key at https://resend.com
RESEND_API_KEY=
# Option B: SMTP (for self-hosted deployments with a custom mail server).
# Local dev: Mailpit runs on port 1025 (no auth required).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Set to true when using port 465 (direct SSL). Leave unset for port 587 (STARTTLS).
SMTP_SECURE=

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Sign up at https://stripe.com — find keys in Dashboard → Developers → API keys.
# Self-hosters: use your own Stripe account and keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Create Products/Prices in Stripe Dashboard and paste the Price IDs here.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=

# ─── Analytics (optional) ────────────────────────────────────────────────────
# URL of the private analytics script server. When set, the script is loaded
# on every page. Leave blank to disable analytics entirely.
NEXT_PUBLIC_ANALYTICS_URL=

# ─── Content-Security-Policy ──────────────────────────────────────────────────
# The web app sends a nonce-based CSP on every HTML response (see apps/web/src/proxy.ts).
# Set CSP_REPORT_ONLY=true to ship it as report-only — browsers report violations
# instead of blocking, which is the safe way to roll out or tighten the policy. Unset
# (or any value other than 'true') enforces it.
CSP_REPORT_ONLY=
# Optional endpoint that receives violation reports (works in both modes). Leave blank
# to report to the browser console only. Example: /api/csp-report
CSP_REPORT_URI=

# ─── Gmail Debug Tools ────────────────────────────────────────────────────────
# Set to true to enable the /dev/gmail-sort-tester route and show it in the nav.
# Only accessible when a Gmail inbox is connected. Never enable in production.
NEXT_PUBLIC_ENABLE_GMAIL_DEBUG_TOOLS=false

# ─── Android App Download Banner ──────────────────────────────────────────────
# Play Store listing URL for the Android app. When set, an Android-only,
# dismissible "download the app" banner shows on the site and web app.
# Config-gated: leave blank until the listing is published.
# Example: https://play.google.com/store/apps/details?id=com.amarnai.app
NEXT_PUBLIC_PLAY_STORE_URL=

# ─── Browser Extension Nudge ──────────────────────────────────────────────────
# Store listing URLs for the browser side-panel extension. When set, the
# one-time "install the extension" bell notification links to the listing that
# matches the user's browser: Firefox gets the AMO link, every other browser
# gets the Chrome Web Store link (covers all Chromium-based browsers). If only
# one is set, it is used regardless of browser. Config-gated: leave both blank
# on self-host without a published listing — the nudge then shows as
# informational text with no click target.
# Example: https://chromewebstore.google.com/detail/<extension-id>
NEXT_PUBLIC_EXTENSION_STORE_URL=
# Example: https://addons.mozilla.org/firefox/addon/<extension-slug>
NEXT_PUBLIC_EXTENSION_STORE_URL_FIREFOX=
