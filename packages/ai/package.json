{
  "name": "@amarnai/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude '**/*-ollama.test.ts'",
    "test:ollama": "vitest run --reporter=verbose src/__tests__/routing-ollama.test.ts",
    "test:sorting": "vitest run --reporter=verbose src/__tests__/sorting-candidate-paths.test.ts src/__tests__/sorting-llm.test.ts src/__tests__/embedding-math.test.ts src/__tests__/embedding-sorter.test.ts",
    "seed:embeddings": "SEED_EMBEDDINGS=1 vitest run --reporter=verbose src/__tests__/fixtures/seed-embeddings.test.ts",
    "benchmark:constants": "tsx src/__tests__/benchmark-constants.ts",
    "benchmark:reasoning": "tsx src/__tests__/benchmark-reasoning.ts"
  },
  "dependencies": {
    "@amarnai/shared": "workspace:*",
    "openai": "^4.100.0",
    "undici": "^8.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
