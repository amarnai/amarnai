{
  "name": "@aziru/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate dev",
    "seed": "dotenv -e ../../.env.local -e ../../.env -- prisma db seed",
    "backfill-inbox": "dotenv -e ../../.env.local -e ../../.env -- tsx prisma/backfill-inbox.ts",
    "backfill-trial-claims": "dotenv -e ../../.env.local -e ../../.env -- tsx prisma/backfill-trial-claims.ts",
    "backfill-catch-all": "dotenv -e ../../.env.local -e ../../.env -- tsx prisma/backfill-catch-all.ts",
    "cleanup-sent-only-threads": "dotenv -e ../../.env.local -e ../../.env -- tsx prisma/cleanup-sent-only-threads.ts",
    "embeddings:refresh-taxonomy": "dotenv -e ../../.env.local -e ../../.env -- tsx prisma/refresh-taxonomy-embeddings.ts",
    "reset": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate reset",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aziru/ai": "workspace:*",
    "@aziru/shared": "workspace:*",
    "@prisma/client": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "bcryptjs": "^3.0.3",
    "prisma": "^6.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
