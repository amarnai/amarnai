generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum Provider {
  GMAIL
}

enum EmailAddressIdentityKind {
  PRIMARY
  ALIAS
  SEND_AS
  UNKNOWN
}

enum SyncStatus {
  IDLE
  SYNCING
  ERROR
}

enum TagSource {
  AMARNAI
  GMAIL
}

enum EmailTagSource {
  USER
  GMAIL_SYNC
  AI_SUGGESTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Urgency {
  NONE
  SOON
  TODAY
  OVERDUE
  UNKNOWN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RequiredAction {
  NONE
  REPLY
  REVIEW
  APPROVE
  SCHEDULE
  PAY
  DELEGATE
  ARCHIVE
  UNKNOWN
}

enum Sensitivity {
  NORMAL
  CONFIDENTIAL
  PERSONAL_DATA
  FINANCIAL
  LEGAL
  SECURITY
}

enum SuggestedNextStep {
  LABEL_ONLY
  CREATE_DRAFT
  ASK_USER
  OPEN_IN_GMAIL
}

enum TriageStatus {
  PENDING
  SORTED
  NEEDS_REVIEW
  UNROUTED
  UNCLASSIFIED
  // Deferred: the workspace hit its monthly thread-sort quota before this thread
  // could be sorted. Not lost — re-enqueued automatically on month rollover or a
  // plan upgrade. Excluded from stuck-recovery and resume so it is never churned.
  QUOTA_BLOCKED
}

// Origin of a thread sort, used to attribute usage per workspace and to decide
// what the recurring monthly quota meters.
//   LIVE     — automatic sort triggered by an inbox sync (new/changed thread).
//   BACKFILL — the one-time historical backfill (exempt from the monthly quota).
//   REROUTE  — resume / route-unrouted / reroute-unclassified re-sorts.
//   MANUAL   — a user-triggered AI sort via the API (real embedding/LLM cost).
//   MOVE     — a manual folder reassignment (no embedding/LLM, zero AI cost);
//              exempt from the monthly quota like BACKFILL.
enum ClassificationSource {
  LIVE
  BACKFILL
  REROUTE
  MANUAL
  MOVE
}

enum BackfillStatus {
  PENDING
  RUNNING
  DONE
  ERROR
}

// Import-limit state the last backfill ended in — drives the adaptive plan-cap banner.
enum BackfillLimitState {
  NONE
  CAPPED
  CAPPED_RETRY
  BLOCKED
}

enum WorkspacePlan {
  FREE
  PRO
  BUSINESS
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum DraftStatus {
  GENERATING
  PROPOSED
  SENT
  CREATED_IN_GMAIL
  REJECTED
  FAILED
}

enum AuditActorType {
  USER
  AI
  SYSTEM
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum GmailConnectionStatus {
  ACTIVE
  DISCONNECTED
}

// Push delivery platform for a registered device. v1 ships Android only
// (Expo Push over FCM); IOS is reserved so the column never needs widening.
enum DevicePlatform {
  ANDROID
  IOS
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  imageUrl      String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  trialUsed     Boolean @default(false)
  isSystemAdmin Boolean @default(false)

  // Weekly lifecycle reminder email. `lifecycleEmailsEnabled` is the opt-out
  // flag (flipped by the unsubscribe link or the in-app toggle).
  // `lifecycleEmailSentAt` is the last send, used by the worker's daily tick to
  // enforce the weekly cadence in a restart-safe, idempotent way.
  lifecycleEmailsEnabled Boolean   @default(true)
  lifecycleEmailSentAt   DateTime?
  locale                 String    @default("en")

  ownedWorkspaces          Workspace[]
  workspaceMemberships     WorkspaceMember[]
  sentWorkspaceInvitations WorkspaceInvitation[]
  emailAccounts            EmailAccount[]
  auditLogs                AuditLog[]
  credential               UserCredential?
  verificationTokens       VerificationToken[]
  refreshTokens            RefreshToken[]
  pushDevices              PushDevice[]
  resolvedThreads          EmailThread[]         @relation("ResolvedByUser")
  assignedThreads          EmailThread[]         @relation("AssignedToUser")
  assignedByThreads        EmailThread[]         @relation("AssignedByUser")
  notifications            Notification[]
}

model Workspace {
  id                     String        @id @default(cuid())
  name                   String
  ownerUserId            String
  locale                 String        @default("en")
  plan                   WorkspacePlan @default(FREE)
  membersCanEditTaxonomy Boolean       @default(false)
  stripeCustomerId       String?
  stripeSubscriptionId   String?       @unique
  stripePriceId          String?
  billingCycle           BillingCycle?
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean       @default(false)
  paymentFailed          Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  owner                   User                     @relation(fields: [ownerUserId], references: [id])
  members                 WorkspaceMember[]
  invitations             WorkspaceInvitation[]
  emailAccounts           EmailAccount[]
  gmailConnection         GmailConnection?
  gmailSyncSettings       GmailSyncSettings?
  taxonomyGenerationState TaxonomyGenerationState?
  taxonomyNodes           TaxonomyNode[]
  taxonomyEdges           TaxonomyEdge[]
  emailThreads            EmailThread[]
  emailMessages           EmailMessage[]
  tags                    Tag[]
  classifications         EmailClassification[]
  drafts                  Draft[]
  auditLogs               AuditLog[]
  notifications           Notification[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
}

model WorkspaceInvitation {
  id              String   @id @default(cuid())
  workspaceId     String
  invitedEmail    String
  invitedByUserId String
  token           String   @unique
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  invitedBy User      @relation(fields: [invitedByUserId], references: [id])

  @@unique([workspaceId, invitedEmail])
}

model EmailAccount {
  id                    String    @id @default(cuid())
  workspaceId           String
  userId                String
  provider              Provider
  primaryEmailAddress   String
  providerAccountId     String
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenExpiresAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace      Workspace              @relation(fields: [workspaceId], references: [id])
  user           User                   @relation(fields: [userId], references: [id])
  emailAddresses EmailAddressIdentity[]
  syncState      ProviderSyncState?
  emailThreads   EmailThread[]
  emailMessages  EmailMessage[]

  @@unique([workspaceId, providerAccountId])
}

model EmailAddressIdentity {
  id             String                   @id @default(cuid())
  emailAccountId String
  emailAddress   String
  displayName    String?
  kind           EmailAddressIdentityKind
  isPrimary      Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id])

  @@unique([emailAccountId, emailAddress])
}

model ProviderSyncState {
  id                       String         @id @default(cuid())
  emailAccountId           String         @unique
  provider                 Provider
  historyId                String?
  lastSyncedAt             DateTime?
  status                   SyncStatus     @default(IDLE)
  errorMessage             String?
  backfillStatus           BackfillStatus @default(PENDING)
  backfillStartedAt        DateTime?
  backfillSkipped          Int            @default(0)
  backfillCompletedAt      DateTime?
  // Resumable-backfill cursor: Gmail threads.list pageToken to fetch next, and
  // the cumulative thread count processed so far toward the plan cap. Both reset
  // when a fresh backfill is requested (e.g. sweep) or on disconnect.
  backfillPageToken        String?
  backfillProcessedCount   Int            @default(0)
  // Gmail's estimate of how many threads match the backfill query (capped at the
  // plan's thread cap), persisted so the UI can show a "loading past threads"
  // progress bar that fills as backfillProcessedCount approaches it. Approximate
  // (Gmail's resultSizeEstimate) and reset on a fresh backfill / disconnect.
  backfillTotalEstimate    Int            @default(0)
  // Bumped whenever a fresh backfill is requested (e.g. sweep). A running chunk
  // records the generation it claimed under and only persists its progress while
  // that generation still matches, so a concurrent reset is never clobbered.
  backfillGeneration       Int            @default(0)
  // Armed by an explicit "Route now" click while a backfill is still in flight.
  // While armed, the sync/backfill backlog gates auto-enqueue newly-arrived
  // PENDING threads for routing instead of leaving them for another manual click.
  // Cleared when the backfill reaches a terminal state (DONE or ERROR).
  autoRouteBacklogArmed    Boolean        @default(false)
  // The live/backfill boundary: set the first time the user explicitly starts
  // backfill routing. Null means routing has not been started — the import runs
  // automatically on connect but nothing is classified, and live sync leaves
  // newly-arrived threads PENDING (they are swept as BACKFILL on start). Once
  // set, live sync resumes classifying new threads as LIVE.
  backfillRoutingStartedAt DateTime?
  // Set to true after a one-time pass that marks existing threads with gmailIsImportant.
  importantBackfilled      Boolean        @default(false)
  // Whether the last backfill stopped because it hit the plan's thread cap (more
  // threads exist in Gmail than the plan ingests). Drives the "upgrade to load
  // more" banner. backfillBeyondCount is Gmail's estimate of how many threads
  // were left beyond the cap (approximate). Reset on a fresh backfill / upgrade.
  backfillCapReached       Boolean        @default(false)
  backfillBeyondCount      Int            @default(0)
  // Which import-limit state the last backfill ended in, for the adaptive banner:
  //   NONE          — no limit hit (banner hidden)
  //   CAPPED        — initial import hit the plan cap; more email exists (retry still available)
  //   CAPPED_RETRY  — the grace re-import hit the cap; the monthly retry is now used
  //   BLOCKED       — base + grace both spent; no import possible until the window rolls
  backfillLimitState       BackfillLimitState @default(NONE)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id])
}

model TaxonomyNode {
  id                 String    @id @default(cuid())
  workspaceId        String
  name               String
  description        String?
  instructions       String?
  draftPrompt        String?
  examples           Json      @default("[]")
  isRoot             Boolean   @default(false)
  // A non-routable catch-all destination ("Updates / Other"). Excluded from
  // embedding/LLM competition; assigned only by the automated-mail policy.
  isCatchAll         Boolean   @default(false)
  positionX          Float     @default(0)
  positionY          Float     @default(0)
  // Embedding cache — recomputed only when embeddingTextHash changes
  embeddingVector    Float[]   @default([])
  embeddingModel     String?
  embeddingTextHash  String?
  embeddingUpdatedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace       Workspace             @relation(fields: [workspaceId], references: [id])
  outgoingEdges   TaxonomyEdge[]        @relation("SourceNode")
  incomingEdges   TaxonomyEdge[]        @relation("TargetNode")
  classifications EmailClassification[]
}

model TaxonomyEdge {
  id           String   @id @default(cuid())
  workspaceId  String
  sourceNodeId String
  targetNodeId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace    @relation(fields: [workspaceId], references: [id])
  sourceNode TaxonomyNode @relation("SourceNode", fields: [sourceNodeId], references: [id])
  targetNode TaxonomyNode @relation("TargetNode", fields: [targetNodeId], references: [id])

  @@unique([workspaceId, sourceNodeId, targetNodeId])
}

model EmailThread {
  id                String       @id @default(cuid())
  workspaceId       String
  emailAccountId    String
  provider          Provider
  providerThreadId  String
  subject           String?
  latestMessageAt   DateTime?
  messageCount      Int          @default(0)
  triageStatus      TriageStatus @default(PENDING)
  classifyingAt     DateTime?
  // Set when a classify-thread job fails permanently (all retries exhausted).
  // Distinguishes a thread that was attempted and failed (eligible for
  // auto-recovery) from the invalid-taxonomy bulk backlog (never attempted,
  // stays behind the manual "Route now"). Cleared on a successful classify.
  classifyFailedAt  DateTime?
  // Number of permanent classify failures; bounds auto-recovery retries so a
  // persistently failing thread is not re-enqueued forever.
  classifyAttempts  Int          @default(0)
  // Gmail category flags — all messages in the thread have the respective label.
  // Used to filter threads at query time based on GmailSyncSettings.
  // gmailIsTrash is always filtered out; gmailIsSpam/Promotions depend on user settings.
  gmailIsSpam       Boolean      @default(false)
  gmailIsPromotions Boolean      @default(false)
  gmailIsTrash      Boolean      @default(false)
  // True when ANY message carries Gmail's IMPORTANT label (priority inbox signal).
  gmailIsImportant  Boolean      @default(false)
  // True when every message looks automated/bulk (notifications, newsletters,
  // service mail). Computed at sync; drives the route-to-catch-all policy.
  isAutomated       Boolean      @default(false)
  resolvedByUserId  String?
  resolvedAt        DateTime?
  // Assignment (thread ownership): who should handle this thread. Independent of
  // the resolved/"done" mark above — assignment is ownership, resolved is
  // completion, and the two can be different people. assignedByUserId records the
  // actor who set the assignment (audit/attribution); it is never client-supplied.
  assignedToUserId  String?
  assignedByUserId  String?
  assignedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace       Workspace             @relation(fields: [workspaceId], references: [id])
  emailAccount    EmailAccount          @relation(fields: [emailAccountId], references: [id])
  resolvedByUser  User?                 @relation("ResolvedByUser", fields: [resolvedByUserId], references: [id])
  assignedToUser  User?                 @relation("AssignedToUser", fields: [assignedToUserId], references: [id])
  assignedByUser  User?                 @relation("AssignedByUser", fields: [assignedByUserId], references: [id])
  messages        EmailMessage[]
  tags            EmailTag[]
  classifications EmailClassification[]
  drafts          Draft[]

  @@unique([emailAccountId, providerThreadId])
  // Supports the recoverFailedThreads sweep: PENDING threads that have failed.
  @@index([workspaceId, triageStatus, classifyFailedAt])
  // Supports a future "assigned to me" filter within a workspace.
  @@index([workspaceId, assignedToUserId])
}

model EmailMessage {
  id                String   @id @default(cuid())
  workspaceId       String
  emailAccountId    String
  emailThreadId     String
  providerMessageId String
  senderEmail       String
  senderName        String?
  toEmails          Json
  ccEmails          Json
  bccEmails         Json
  subject           String?
  snippet           String?
  bodyText          String?
  bodyHash          String?
  receivedAt        DateTime
  hasAttachments    Boolean  @default(false)
  attachments       Json     @default("[]")
  rawMetadata       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace       Workspace             @relation(fields: [workspaceId], references: [id])
  emailAccount    EmailAccount          @relation(fields: [emailAccountId], references: [id])
  thread          EmailThread           @relation(fields: [emailThreadId], references: [id])
  tags            EmailTag[]
  classifications EmailClassification[]
  drafts          Draft[]

  @@unique([emailAccountId, providerMessageId])
}

model Tag {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  color        String?
  source       TagSource
  gmailLabelId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id])
  emailTags EmailTag[]

  @@unique([workspaceId, name])
}

model EmailTag {
  id             String         @id @default(cuid())
  emailThreadId  String?
  emailMessageId String?
  tagId          String
  source         EmailTagSource
  createdAt      DateTime       @default(now())

  emailThread  EmailThread?  @relation(fields: [emailThreadId], references: [id])
  emailMessage EmailMessage? @relation(fields: [emailMessageId], references: [id])
  tag          Tag           @relation(fields: [tagId], references: [id])
}

model EmailClassification {
  id                String               @id @default(cuid())
  workspaceId       String
  emailThreadId     String
  emailMessageId    String?
  finalNodeId       String?
  path              Json                 @default("[]")
  confidence        Float
  explanation       String?
  priority          Priority?
  urgency           Urgency?
  riskLevel         RiskLevel?
  requiredAction    RequiredAction?
  sensitivity       Sensitivity?
  dueAt             DateTime?
  suggestedNextStep SuggestedNextStep?
  needsHumanReview  Boolean
  source            ClassificationSource @default(LIVE)
  decisionSource    String?
  modelProvider     String?
  modelName         String?
  promptVersion     String?
  rawOutput         Json?
  createdAt         DateTime             @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  emailThread  EmailThread   @relation(fields: [emailThreadId], references: [id])
  emailMessage EmailMessage? @relation(fields: [emailMessageId], references: [id])
  finalNode    TaxonomyNode? @relation(fields: [finalNodeId], references: [id])
  drafts       Draft[]

  // Supports the monthly thread-sort quota count + usage reporting, which filter
  // by workspace and createdAt window and split distinct threads by source.
  @@index([workspaceId, createdAt, source])
}

model Draft {
  id               String      @id @default(cuid())
  workspaceId      String
  emailThreadId    String
  emailMessageId   String?
  classificationId String?
  providerDraftId  String?
  subject          String?
  body             String
  status           DraftStatus @default(PROPOSED)
  errorMessage     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  workspace      Workspace            @relation(fields: [workspaceId], references: [id])
  emailThread    EmailThread          @relation(fields: [emailThreadId], references: [id])
  emailMessage   EmailMessage?        @relation(fields: [emailMessageId], references: [id])
  classification EmailClassification? @relation(fields: [classificationId], references: [id])
}

model AuditLog {
  id          String         @id @default(cuid())
  workspaceId String
  actorType   AuditActorType
  actorUserId String?
  eventType   String
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  actor     User?     @relation(fields: [actorUserId], references: [id])
}

// Generic, feature-agnostic in-app notification. `type` is a free-form string
// (not an enum) so new producers can be added without a migration, and `params`
// holds structured, localization-neutral data — display text is rendered on the
// client from type+params at render time, never stored here (localize-at-edges).
// Recipient-scoped by userId; workspaceId lets the client deep-link into the
// right workspace. Kept lean: rows are pruned past a retention window at insert.
model Notification {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  type        String
  params      Json      @default("{}")
  readAt      DateTime?
  // Set when the recipient has dealt with the notification (clicked through or
  // explicitly dismissed). Independent of readAt: readAt clears the bell badge
  // ("seen"), dismissedAt removes the row from the bell pop-up feed ("dealt
  // with"). Dismissed rows still appear on the full notifications page, which is
  // the archive. Nulls sort as not-yet-dismissed.
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  // Unread-count lookups and feed pagination / retention pruning. The pop-up
  // feed additionally filters dismissedAt IS NULL within the createdAt ordering.
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model UserCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  token     String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Long-lived refresh tokens for native clients (mobile). The raw token is
// returned to the device once; only its SHA-256 hash is stored. Tokens rotate on
// every refresh: the presented token is marked used (usedAt) and a child token is
// issued in the same family. Presenting an already-used token signals theft and
// revokes the whole family. Logout revokes the family too.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// A registered Expo push token for one of a user's devices. Tenant-scoped per
// userId so pushes are attributable per user for hosted cost accounting (a
// workspace fans out to every member's devices at emit time). The Expo token is
// the natural key: it is unique per app install and rotates when the install is
// reset, so we upsert on it and reassign ownership if a device is handed over to
// a different user. No email content is stored here.
model PushDevice {
  id            String         @id @default(cuid())
  userId        String
  expoPushToken String         @unique
  platform      DevicePlatform
  // Bumped on every re-registration; lets a future reaper prune tokens that
  // Expo reports as DeviceNotRegistered or that have gone silent for too long.
  lastSeenAt    DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GmailConnection {
  id                    String                @id @default(cuid())
  workspaceId           String                @unique
  googleSubjectId       String?
  gmailAddress          String
  encryptedRefreshToken String
  grantedScopes         String[]
  status                GmailConnectionStatus @default(ACTIVE)
  lastVerifiedAt        DateTime?
  gmailWatchExpiresAt   DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model GmailSyncSettings {
  id                      String   @id @default(cuid())
  workspaceId             String   @unique
  includeSpam             Boolean  @default(false)
  includePromotions       Boolean  @default(false)
  sortingPaused           Boolean  @default(false)
  // When true, threads detected as automated/bulk are auto-filed to the
  // taxonomy's catch-all folder without invoking the LLM.
  routeBulkToOther        Boolean  @default(true)
  blacklistedSenderEmails String[] @default([])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

// Per-workspace state for the auto-generate-taxonomy-from-inbox feature.
// Holds the latest generated proposal (awaiting user apply), the current job
// status, and the counters that drive the cost limiter (delta gate, cooldown,
// monthly backstop). One row per workspace.
enum TaxonomyGenerationStatus {
  IDLE
  RUNNING
  READY
  INSUFFICIENT
  FAILED
}

model TaxonomyGenerationState {
  id                     String                   @id @default(cuid())
  workspaceId            String                   @unique
  status                 TaxonomyGenerationStatus @default(IDLE)
  // The most recent generated TaxonomyTransferFile, awaiting user apply.
  // Null until the first READY result; cleared is not required (overwritten).
  proposal               Json?
  matchedTemplateId      String?
  // Last successful generation: timestamp + the eligible-thread count at that
  // time. Drives the delta gate (regenerate only after enough new signal).
  lastGeneratedAt        DateTime?
  threadCountAtLastGen   Int?
  // Outcome of the last completed run (SUCCESS | INSUFFICIENT | FAILED).
  // Distinct from `status`, which is the live job state. Drives the cooldown.
  lastOutcome            String?
  // Rolling 30-day backstop quota window.
  generationsWindowStart DateTime?
  generationsInWindow    Int                      @default(0)
  // Cost attribution for the generation LLM call.
  modelProvider          String?
  modelName              String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

// What a usage meter row counts. One meter family per cost driver.
enum MeterKind {
  THREAD_SORT
  DRAFT
  TAXONOMY_GEN
  BACKFILL
}

// Reset-immune, inbox-keyed usage meter. Anti-abuse cost accounting lives here,
// NOT on workspace-owned rows: a workspace reset / delete wipes EmailClassification,
// Draft, ProviderSyncState, TaxonomyGenerationState — the rows the old per-tenant
// quotas counted — which refunded already-spent LLM cost. This table is keyed only
// on the normalized inbox address (see normalizeInboxKey) and has NO relation or FK
// to Workspace/GmailConnection, so no `onDelete: Cascade` and no `where: { workspaceId }`
// teardown can reach it. Usage is POOLED across every workspace/account that connects
// the same inbox, sized by the top plan among them. One row per (inboxKey, kind, window).
//
// IMPORTANT: do not add this model to any teardown in packages/db/src/workspace-ops.ts,
// and do not add a back-relation on Workspace/GmailConnection.
model InboxUsageMeter {
  id           String         @id @default(cuid())
  // Normalized inbox identity (NOT a workspace/user). The pooling key.
  inboxKey     String
  kind         MeterKind
  // Calendar-month UTC bucket start (getDraftQuotaWindowStart). BACKFILL uses the
  // same monthly bucket so budget + grace replenish monthly.
  windowStart  DateTime
  // Monotonic consumption counter for this window. Never decremented.
  used         Int            @default(0)
  // BACKFILL only: the single per-(inboxKey, month) grace token. Once true, a reset
  // re-import is blocked until the window rolls over.
  graceUsed    Boolean        @default(false)
  // Observability: the plan ceiling that first sized this window's budget.
  sizedForPlan WorkspacePlan?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([inboxKey, kind, windowStart])
  @@index([inboxKey, kind])
}

// BACKFILL only: records that a specific workspace has already been granted its
// one-time free import of this inbox. Distinguishes a genuinely-new sharing
// workspace (allowed one import from the pool) from a reset-and-redo of a workspace
// that already imported (which must draw from the shared grace token, not a fresh
// allowance). Keyed on (inboxKey, workspaceId) as plain Strings — no relation/FK —
// so it survives workspace reset, exactly like InboxUsageMeter.
model InboxBackfillGrant {
  id           String   @id @default(cuid())
  inboxKey     String
  // Attribution only — a plain String, NOT a relation (must survive reset).
  workspaceId  String
  // Threads consumed under this workspace's one-time free allowance.
  freeConsumed Int      @default(0)
  grantedAt    DateTime @default(now())

  @@unique([inboxKey, workspaceId])
  @@index([inboxKey])
}
