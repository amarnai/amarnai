generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum Provider {
  GMAIL
  OUTLOOK
}

enum EmailAddressIdentityKind {
  PRIMARY
  ALIAS
  SEND_AS
  UNKNOWN
}

enum SyncStatus {
  IDLE
  SYNCING
  ERROR
}

enum TagSource {
  AMARNAI
  GMAIL
}

enum EmailTagSource {
  USER
  GMAIL_SYNC
  AI_SUGGESTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Urgency {
  NONE
  SOON
  TODAY
  OVERDUE
  UNKNOWN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RequiredAction {
  NONE
  REPLY
  REVIEW
  APPROVE
  SCHEDULE
  PAY
  DELEGATE
  ARCHIVE
  UNKNOWN
}

enum Sensitivity {
  NORMAL
  CONFIDENTIAL
  PERSONAL_DATA
  FINANCIAL
  LEGAL
  SECURITY
}

enum SuggestedNextStep {
  LABEL_ONLY
  CREATE_DRAFT
  ASK_USER
  OPEN_IN_GMAIL
}

enum TriageStatus {
  PENDING
  SORTED
  NEEDS_REVIEW
  UNROUTED
  UNCLASSIFIED
  // Deferred: the workspace hit its monthly thread-sort quota before this thread
  // could be sorted. Not lost — re-enqueued automatically on month rollover or a
  // plan upgrade. Excluded from stuck-recovery and resume so it is never churned.
  QUOTA_BLOCKED
}

// Origin of a thread sort, used to attribute usage per workspace and to decide
// what the recurring monthly quota meters.
//   LIVE     — automatic sort triggered by an inbox sync (new/changed thread).
//   BACKFILL — the one-time historical backfill (exempt from the monthly quota).
//   REROUTE  — resume / route-unrouted / reroute-unclassified re-sorts.
//   MANUAL   — a user-triggered AI sort via the API (real embedding/LLM cost).
//   MOVE     — a manual folder reassignment (no embedding/LLM, zero AI cost);
//              exempt from the monthly quota like BACKFILL.
enum ClassificationSource {
  LIVE
  BACKFILL
  REROUTE
  MANUAL
  MOVE
  // Folder-to-folder remap during a taxonomy replace. Runs no embedding/LLM
  // (zero AI cost), so it is quota-exempt like MOVE.
  MIGRATION
}

enum BackfillStatus {
  PENDING
  RUNNING
  DONE
  ERROR
}

// Import-limit state the last backfill ended in — drives the adaptive plan-cap banner.
enum BackfillLimitState {
  NONE
  CAPPED
  CAPPED_RETRY
  BLOCKED
}

enum WorkspacePlan {
  FREE
  PRO
  BUSINESS
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum DraftStatus {
  GENERATING
  PROPOSED
  SENT
  CREATED_IN_GMAIL
  REJECTED
  FAILED
}

enum ThreadSummaryStatus {
  GENERATING
  READY
  FAILED
}

// Shape the model chose for a summary. Prose is the default; BULLETS is reserved
// for threads that genuinely enumerate facts (times, places, documents, action
// items), where flattening them into a sentence loses the structure.
enum ThreadSummaryFormat {
  PROSE
  BULLETS
}

enum AuditActorType {
  USER
  AI
  SYSTEM
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ConnectionStatus {
  ACTIVE
  DISCONNECTED
}

// Push delivery platform for a registered device. v1 ships Android only
// (Expo Push over FCM); IOS is reserved so the column never needs widening.
enum DevicePlatform {
  ANDROID
  IOS
}

enum ExtensionBrowser {
  CHROME
  FIREFOX
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  imageUrl      String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  trialUsed     Boolean @default(false)
  isSystemAdmin Boolean @default(false)

  // Set the first time this account completes a Google (OAuth) sign-in. Its
  // presence is the authoritative signal of a real federated link — as opposed to
  // an email-first account that simply has no password yet. Recovery flows use it
  // so a passwordless email-first user is never misdirected to "sign in with
  // Google" (register) and can still be issued a set-password token (forgot
  // password). Backfilled for pre-existing verified-without-password accounts.
  googleLinkedAt DateTime?

  // Microsoft counterpart of `googleLinkedAt`, with identical semantics: set the
  // first time this account completes a Microsoft (Entra) sign-in and never
  // cleared. An account can carry both if the same address signs in with both
  // providers; recovery flows treat either as "federated, holds no password".
  microsoftLinkedAt DateTime?

  // Monotonic session-invalidation counter. Stamped into every issued web JWT and
  // re-checked on refresh: bumping this invalidates all existing stateless
  // sessions at once (there is no server-side session store to revoke). Bumped
  // when an untrusted pre-verification password credential is invalidated, so an
  // attacker who planted a password (and opened a session) on someone else's
  // email cannot retain access once the real owner verifies the mailbox.
  sessionEpoch Int @default(0)

  // Weekly lifecycle reminder email. `lifecycleEmailsEnabled` is the opt-out
  // flag (flipped by the unsubscribe link or the in-app toggle).
  // `lifecycleEmailSentAt` is the last send, used by the worker's daily tick to
  // enforce the weekly cadence in a restart-safe, idempotent way.
  lifecycleEmailsEnabled Boolean   @default(true)
  lifecycleEmailSentAt   DateTime?
  locale                 String    @default("en")

  // One-time "install the browser extension" nudge. Set the first (and only) time
  // the nudge is produced, so it never re-fires on a later Gmail reconnect even if
  // the user dismisses or deletes the notification row. Independent of the
  // ExtensionInstall record: this survives; the notification row is disposable.
  extensionNudgedAt DateTime?

  ownedWorkspaces          Workspace[]
  workspaceMemberships     WorkspaceMember[]
  sentWorkspaceInvitations WorkspaceInvitation[]
  emailAccounts            EmailAccount[]
  auditLogs                AuditLog[]
  credential               UserCredential?
  verificationTokens       VerificationToken[]
  refreshTokens            RefreshToken[]
  authBridgeCodes          AuthBridgeCode[]
  pushDevices              PushDevice[]
  extensionInstall         ExtensionInstall?
  resolvedThreads          EmailThread[]         @relation("ResolvedByUser")
  assignedThreads          EmailThread[]         @relation("AssignedToUser")
  assignedByThreads        EmailThread[]         @relation("AssignedByUser")
  notifications            Notification[]
}

model Workspace {
  id                     String        @id @default(cuid())
  name                   String
  ownerUserId            String
  locale                 String        @default("en")
  plan                   WorkspacePlan @default(FREE)
  membersCanEditTaxonomy Boolean       @default(false)
  stripeCustomerId       String?
  stripeSubscriptionId   String?       @unique
  stripePriceId          String?
  billingCycle           BillingCycle?
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean       @default(false)
  paymentFailed          Boolean       @default(false)
  // First successful (non-zero) Stripe payment for this workspace. Null = never
  // paid (FREE, still trialing, or self-host). Gates the plan-level BACKFILL cap:
  // FREE/TRIALING workspaces backfill at the FREE cap until this is set; sorts,
  // drafts, and seats stay at plan level during the trial. Monotonic — set once on
  // first payment, never cleared (refund/dispute handling is out of scope).
  firstPaidAt            DateTime?
  // One-shot marker for the "monthly sorting limit reached" (quota_blocked)
  // notification: the meter window we last notified members about. Claimed
  // atomically (WHERE null OR lt windowStart) so a burst of QUOTA_BLOCKED threads
  // produces exactly one notification per (workspace, window). Monotonic — never
  // reset on quota recovery, so recovery within the same window cannot re-arm it.
  quotaNotifiedWindowStart DateTime?
  // Last routing-relevant taxonomy mutation (node create/delete, name or
  // description edit, edge change, full import). Drives NEEDS_REVIEW re-sort
  // eligibility: a thread whose latest classification predates this may route
  // differently now. Null until the taxonomy is first edited.
  taxonomyChangedAt      DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  owner                   User                     @relation(fields: [ownerUserId], references: [id])
  members                 WorkspaceMember[]
  invitations             WorkspaceInvitation[]
  emailAccounts           EmailAccount[]
  emailConnection         EmailConnection?
  gmailSyncSettings       GmailSyncSettings?
  taxonomyGenerationState TaxonomyGenerationState?
  taxonomyNodes           TaxonomyNode[]
  taxonomyEdges           TaxonomyEdge[]
  taxonomyNodeReferences  TaxonomyNodeReference[]
  taxonomyProviderLinks   TaxonomyNodeProviderLink[]
  emailThreads            EmailThread[]
  emailMessages           EmailMessage[]
  tags                    Tag[]
  classifications         EmailClassification[]
  drafts                  Draft[]
  threadSummaries         ThreadSummary[]
  auditLogs               AuditLog[]
  notifications           Notification[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
}

model WorkspaceInvitation {
  id              String   @id @default(cuid())
  workspaceId     String
  invitedEmail    String
  invitedByUserId String
  token           String   @unique
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  invitedBy User      @relation(fields: [invitedByUserId], references: [id])

  @@unique([workspaceId, invitedEmail])
}

model EmailAccount {
  id                    String    @id @default(cuid())
  workspaceId           String
  userId                String
  provider              Provider
  primaryEmailAddress   String
  providerAccountId     String
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenExpiresAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace      Workspace              @relation(fields: [workspaceId], references: [id])
  user           User                   @relation(fields: [userId], references: [id])
  emailAddresses EmailAddressIdentity[]
  syncState      ProviderSyncState?
  emailThreads   EmailThread[]
  emailMessages  EmailMessage[]

  @@unique([workspaceId, providerAccountId])
}

model EmailAddressIdentity {
  id             String                   @id @default(cuid())
  emailAccountId String
  emailAddress   String
  displayName    String?
  kind           EmailAddressIdentityKind
  isPrimary      Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id])

  @@unique([emailAccountId, emailAddress])
}

model ProviderSyncState {
  id                       String         @id @default(cuid())
  emailAccountId           String         @unique
  provider                 Provider
  historyId                String?
  lastSyncedAt             DateTime?
  status                   SyncStatus     @default(IDLE)
  errorMessage             String?
  backfillStatus           BackfillStatus @default(PENDING)
  backfillStartedAt        DateTime?
  backfillSkipped          Int            @default(0)
  backfillCompletedAt      DateTime?
  // Resumable-backfill cursor: Gmail threads.list pageToken to fetch next, and
  // the cumulative thread count processed so far toward the plan cap. Both reset
  // when a fresh backfill is requested (e.g. sweep) or on disconnect.
  backfillPageToken        String?
  backfillProcessedCount   Int            @default(0)
  // Gmail's estimate of how many threads match the backfill query (capped at the
  // plan's thread cap), persisted so the UI can show a "loading past threads"
  // progress bar that fills as backfillProcessedCount approaches it. Approximate
  // (Gmail's resultSizeEstimate) and reset on a fresh backfill / disconnect.
  backfillTotalEstimate    Int            @default(0)
  // Bumped whenever a fresh backfill is requested (e.g. sweep). A running chunk
  // records the generation it claimed under and only persists its progress while
  // that generation still matches, so a concurrent reset is never clobbered.
  backfillGeneration       Int            @default(0)
  // Armed by an explicit "Route now" click while a backfill is still in flight.
  // While armed, the sync/backfill backlog gates auto-enqueue newly-arrived
  // PENDING threads for routing instead of leaving them for another manual click.
  // Cleared when the backfill reaches a terminal state (DONE or ERROR).
  autoRouteBacklogArmed    Boolean        @default(false)
  // The live/backfill boundary: set the first time the user explicitly starts
  // backfill routing. Null means routing has not been started — the import runs
  // automatically on connect but nothing is classified, and live sync leaves
  // newly-arrived threads PENDING (they are swept as BACKFILL on start). Once
  // set, live sync resumes classifying new threads as LIVE.
  backfillRoutingStartedAt DateTime?
  // Whether the last backfill stopped because it hit the plan's thread cap (more
  // threads exist in Gmail than the plan ingests). Drives the "upgrade to load
  // more" banner. backfillBeyondCount is Gmail's estimate of how many threads
  // were left beyond the cap (approximate). Reset on a fresh backfill / upgrade.
  backfillCapReached       Boolean        @default(false)
  backfillBeyondCount      Int            @default(0)
  // Which import-limit state the last backfill ended in, for the adaptive banner:
  //   NONE          — no limit hit (banner hidden)
  //   CAPPED        — initial import hit the plan cap; more email exists (retry still available)
  //   CAPPED_RETRY  — the grace re-import hit the cap; the monthly retry is now used
  //   BLOCKED       — base + grace both spent; no import possible until the window rolls
  backfillLimitState       BackfillLimitState @default(NONE)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id])
}

model TaxonomyNode {
  id                 String    @id @default(cuid())
  workspaceId        String
  name               String
  description        String?
  instructions       String?
  draftPrompt        String?
  examples           Json      @default("[]")
  isRoot             Boolean   @default(false)
  // A non-routable catch-all destination ("Updates / Other"). Excluded from
  // embedding/LLM competition; assigned only by the automated-mail policy.
  isCatchAll         Boolean   @default(false)
  // Optional per-folder color override (a palette key, never a raw hex).
  // null = use the deterministic hash default. Unknown/legacy keys fall back
  // to the default at render time; see packages/core folderColor.
  colorKey           String?
  positionX          Float     @default(0)
  positionY          Float     @default(0)
  // Embedding cache — recomputed only when embeddingTextHash changes
  embeddingVector    Float[]   @default([])
  embeddingModel     String?
  embeddingTextHash  String?
  embeddingUpdatedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace       Workspace                  @relation(fields: [workspaceId], references: [id])
  outgoingEdges   TaxonomyEdge[]             @relation("SourceNode")
  incomingEdges   TaxonomyEdge[]             @relation("TargetNode")
  classifications EmailClassification[]
  references      TaxonomyNodeReference[]
  providerLinks   TaxonomyNodeProviderLink[]
}

// Maps a taxonomy node to its provider-side identifier for opt-in folder→label
// writeback (Gmail label id / Outlook category displayName). Off by default;
// rows exist only for workspaces that enabled writeback and granted the modify
// scope. A separate table (not columns on TaxonomyNode) so provisioning writes
// never churn the node's embedding-cache row, and so the future multi-provider
// relaxation of EmailConnection.workspaceId needs no redesign here.
model TaxonomyNodeProviderLink {
  id          String   @id @default(cuid())
  workspaceId String
  nodeId      String
  provider    Provider
  // Mailbox identity (subjectId ?? emailAddress) — same derivation the sync
  // worker uses. A provision run deletes rows whose key no longer matches the
  // connected mailbox, so inbox rotation self-heals without a cleanup hook.
  mailboxKey  String
  // Gmail: label id ("Label_123"). Outlook: category displayName (its identifier).
  providerLabelId String
  // The "Amarnai/Parent/Child" path used at provisioning time. Drift between this
  // and the node's current path is the seam for the deferred rename cascade.
  providerPath    String
  provisionedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id])
  node      TaxonomyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, provider])
  @@index([workspaceId, provider])
}

model TaxonomyEdge {
  id           String   @id @default(cuid())
  workspaceId  String
  sourceNodeId String
  targetNodeId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace    @relation(fields: [workspaceId], references: [id])
  sourceNode TaxonomyNode @relation("SourceNode", fields: [sourceNodeId], references: [id])
  targetNode TaxonomyNode @relation("TargetNode", fields: [targetNodeId], references: [id])

  @@unique([workspaceId, sourceNodeId, targetNodeId])
}

// A thread a user MANUALLY moved into a folder, kept as a routing exemplar:
// at sort time, similarity to a node's reference threads lifts that node's
// score, pulling similar new threads toward the human-chosen folder. Written
// ONLY by the manual-move API branch (source MOVE) — never by any AI path —
// so the sorter cannot reinforce its own decisions (feedback-loop guard).
// One row per thread (latest human decision wins); a re-move repoints nodeId
// and keeps the content-derived vector. An empty embeddingVector marks a
// pending row awaiting the capture-reference job; the sort-time loader skips
// pending and model-mismatched rows (mirrors the TaxonomyNode embedding cache).
model TaxonomyNodeReference {
  id                String    @id @default(cuid())
  workspaceId       String
  nodeId            String
  emailThreadId     String    @unique
  embeddingVector   Float[]   @default([])
  embeddingModel    String?
  embeddingTextHash String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  node        TaxonomyNode @relation(fields: [nodeId], references: [id])
  emailThread EmailThread  @relation(fields: [emailThreadId], references: [id])

  // Sort-time load (per workspace) and per-node recency prune.
  @@index([workspaceId, nodeId, updatedAt])
}

model EmailThread {
  id                String       @id @default(cuid())
  workspaceId       String
  emailAccountId    String
  provider          Provider
  providerThreadId  String
  // Representative message deep-link for providers whose thread id is not itself
  // URL-resolvable (Outlook conversationId). Null for Gmail, where
  // providerThreadId doubles as the deep-link key.
  webLink           String?
  subject           String?
  latestMessageAt   DateTime?
  messageCount      Int          @default(0)
  triageStatus      TriageStatus @default(PENDING)
  classifyingAt     DateTime?
  // Set when a classify-thread job fails permanently (all retries exhausted).
  // Distinguishes a thread that was attempted and failed (eligible for
  // auto-recovery) from the invalid-taxonomy bulk backlog (never attempted,
  // stays behind the manual "Route now"). Cleared on a successful classify.
  classifyFailedAt  DateTime?
  // Number of permanent classify failures; bounds auto-recovery retries so a
  // persistently failing thread is not re-enqueued forever.
  classifyAttempts  Int          @default(0)
  // Gmail category flags — all messages in the thread have the respective label.
  // Used to filter threads at query time based on GmailSyncSettings.
  // gmailIsTrash is always filtered out; gmailIsSpam/Promotions depend on user settings.
  gmailIsSpam       Boolean      @default(false)
  gmailIsPromotions Boolean      @default(false)
  gmailIsTrash      Boolean      @default(false)
  // User-marked "important" star. Set from the Amarnai UI (never derived from
  // Gmail's own IMPORTANT label); shared across the workspace.
  isImportant       Boolean      @default(false)
  // True when every message looks automated/bulk (notifications, newsletters,
  // service mail). Computed at sync; drives the route-to-catch-all policy.
  isAutomated       Boolean      @default(false)
  resolvedByUserId  String?
  resolvedAt        DateTime?
  // Assignment (thread ownership): who should handle this thread. Independent of
  // the resolved/"done" mark above — assignment is ownership, resolved is
  // completion, and the two can be different people. assignedByUserId records the
  // actor who set the assignment (audit/attribution); it is never client-supplied.
  assignedToUserId  String?
  assignedByUserId  String?
  assignedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace       Workspace             @relation(fields: [workspaceId], references: [id])
  emailAccount    EmailAccount          @relation(fields: [emailAccountId], references: [id])
  resolvedByUser  User?                 @relation("ResolvedByUser", fields: [resolvedByUserId], references: [id])
  assignedToUser  User?                 @relation("AssignedToUser", fields: [assignedToUserId], references: [id])
  assignedByUser  User?                 @relation("AssignedByUser", fields: [assignedByUserId], references: [id])
  messages        EmailMessage[]
  tags            EmailTag[]
  classifications EmailClassification[]
  drafts          Draft[]
  nodeReference   TaxonomyNodeReference?
  summary         ThreadSummary?

  @@unique([emailAccountId, providerThreadId])
  // Supports the recoverFailedThreads sweep: PENDING threads that have failed.
  @@index([workspaceId, triageStatus, classifyFailedAt])
  // Supports a future "assigned to me" filter within a workspace.
  @@index([workspaceId, assignedToUserId])
}

model EmailMessage {
  id                String   @id @default(cuid())
  workspaceId       String
  emailAccountId    String
  emailThreadId     String
  providerMessageId String
  senderEmail       String
  senderName        String?
  toEmails          Json
  ccEmails          Json
  bccEmails         Json
  subject           String?
  snippet           String?
  bodyText          String?
  bodyHash          String?
  receivedAt        DateTime
  hasAttachments    Boolean  @default(false)
  attachments       Json     @default("[]")
  rawMetadata       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace       Workspace             @relation(fields: [workspaceId], references: [id])
  emailAccount    EmailAccount          @relation(fields: [emailAccountId], references: [id])
  thread          EmailThread           @relation(fields: [emailThreadId], references: [id])
  tags            EmailTag[]
  classifications EmailClassification[]
  drafts          Draft[]

  @@unique([emailAccountId, providerMessageId])
}

model Tag {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  color        String?
  source       TagSource
  gmailLabelId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id])
  emailTags EmailTag[]

  @@unique([workspaceId, name])
}

model EmailTag {
  id             String         @id @default(cuid())
  emailThreadId  String?
  emailMessageId String?
  tagId          String
  source         EmailTagSource
  createdAt      DateTime       @default(now())

  emailThread  EmailThread?  @relation(fields: [emailThreadId], references: [id])
  emailMessage EmailMessage? @relation(fields: [emailMessageId], references: [id])
  tag          Tag           @relation(fields: [tagId], references: [id])
}

model EmailClassification {
  id                String               @id @default(cuid())
  workspaceId       String
  emailThreadId     String
  emailMessageId    String?
  finalNodeId       String?
  path              Json                 @default("[]")
  confidence        Float
  explanation       String?
  priority          Priority?
  urgency           Urgency?
  riskLevel         RiskLevel?
  requiredAction    RequiredAction?
  sensitivity       Sensitivity?
  dueAt             DateTime?
  suggestedNextStep SuggestedNextStep?
  needsHumanReview  Boolean
  // True when this row is an inbox fallback caused by a transient infrastructure
  // failure (LLM fail-open on final retry, thread-embedding failure) rather than
  // a deliberate routing decision. Such threads are eligible for re-sort even
  // when the taxonomy has not changed.
  transientFailure  Boolean              @default(false)
  source            ClassificationSource @default(LIVE)
  decisionSource    String?
  modelProvider     String?
  modelName         String?
  promptVersion     String?
  rawOutput         Json?
  createdAt         DateTime             @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id])
  emailThread  EmailThread   @relation(fields: [emailThreadId], references: [id])
  emailMessage EmailMessage? @relation(fields: [emailMessageId], references: [id])
  finalNode    TaxonomyNode? @relation(fields: [finalNodeId], references: [id])
  drafts       Draft[]

  // Supports the monthly thread-sort quota count + usage reporting, which filter
  // by workspace and createdAt window and split distinct threads by source.
  @@index([workspaceId, createdAt, source])
}

model Draft {
  id               String      @id @default(cuid())
  workspaceId      String
  emailThreadId    String
  emailMessageId   String?
  classificationId String?
  providerDraftId  String?
  subject          String?
  body             String
  status           DraftStatus @default(PROPOSED)
  errorMessage     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  workspace      Workspace            @relation(fields: [workspaceId], references: [id])
  emailThread    EmailThread          @relation(fields: [emailThreadId], references: [id])
  emailMessage   EmailMessage?        @relation(fields: [emailMessageId], references: [id])
  classification EmailClassification? @relation(fields: [classificationId], references: [id])
}

// Cached AI TL;DR of a thread, generated lazily the first time a user opens the
// thread. One row per thread (a cache, not a history): a regeneration overwrites
// in place. Lives in Postgres rather than the worker's ai-dedup cache because a
// summary is a paid artifact — losing it burns quota again — and that cache
// fails open and evicts.
//
// Invalidation is by messageSetSignature (sha1-16 of the sorted providerMessageIds,
// the same helper the classify dedup key uses) plus `locale`: a new message in the
// thread or a workspace locale change makes the stored text stale and the next
// open regenerates. `summary` is derived email content — never logged.
model ThreadSummary {
  id                  String              @id @default(cuid())
  workspaceId         String
  emailThreadId       String              @unique
  status              ThreadSummaryStatus @default(GENERATING)
  // Exactly one of these carries the summary, per `format`: `summary` for PROSE,
  // `bullets` for BULLETS. Both are derived email content and are never logged.
  summary             String?
  bullets             String[]            @default([])
  format              ThreadSummaryFormat @default(PROSE)
  // Workspace locale at generation time; a change invalidates the cached text.
  locale              String
  model               String?
  // Prompt/output-contract generation (SUMMARY_PROMPT_VERSION). Compared like the
  // locale and the signature, so changing how summaries are written regenerates
  // them instead of serving output produced under the old rules forever.
  promptVersion       String              @default("1")
  messageSetSignature String
  errorMessage        String?
  generatedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  emailThread EmailThread @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AuditLog {
  id          String         @id @default(cuid())
  workspaceId String
  actorType   AuditActorType
  actorUserId String?
  eventType   String
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  actor     User?     @relation(fields: [actorUserId], references: [id])
}

// Generic, feature-agnostic in-app notification. `type` is a free-form string
// (not an enum) so new producers can be added without a migration, and `params`
// holds structured, localization-neutral data — display text is rendered on the
// client from type+params at render time, never stored here (localize-at-edges).
// Recipient-scoped by userId; workspaceId lets the client deep-link into the
// right workspace. Kept lean: rows are pruned past a retention window at insert.
model Notification {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  type        String
  params      Json      @default("{}")
  readAt      DateTime?
  // Set when the recipient has dealt with the notification (clicked through or
  // explicitly dismissed). Independent of readAt: readAt clears the bell badge
  // ("seen"), dismissedAt removes the row from the bell pop-up feed ("dealt
  // with"). Dismissed rows still appear on the full notifications page, which is
  // the archive. Nulls sort as not-yet-dismissed.
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  // Unread-count lookups and feed pagination / retention pruning. The pop-up
  // feed additionally filters dismissedAt IS NULL within the createdAt ordering.
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model UserCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  token     String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id])

  // At most one live token per (user, type). Enforced by the database, not by
  // call-site delete-then-create discipline, so concurrent issuance cannot leave
  // two valid tokens (issuers upsert on this key). Also provides the userId index.
  @@unique([userId, type])
}

// Long-lived refresh tokens for native clients (mobile). The raw token is
// returned to the device once; only its SHA-256 hash is stored. Tokens rotate on
// every refresh: the presented token is marked used (usedAt), a child token is
// issued in the same family, and the parent records the child's id (replacedById).
// Re-presenting an already-used parent within a short grace window is a benign
// retry (the client lost the rotation response and never advanced), so the family
// is left intact — unless the child was ALSO used, which means the chain forked
// into two live branches (theft). A replay AFTER the grace window is treated as
// theft unconditionally and revokes the family. Logout revokes the family.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  usedAt    DateTime?
  // The child minted when this token was rotated. Lets reuse-detection tell a
  // benign retry (child unused) from a real fork (child used) without a timer.
  replacedById String?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// A one-time code that carries an already-authenticated extension user into a
// web session, so clicking a link in the side panel never dead-ends at /sign-in.
// The raw code is returned to the panel once; only its SHA-256 hash is stored, so
// a database leak cannot be replayed. Single-use (usedAt is claimed atomically)
// and short-lived: the code exists only for the seconds between the click and the
// redirect, which is what keeps a leaked URL from being worth replaying.
model AuthBridgeCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A registered Expo push token for one of a user's devices. Tenant-scoped per
// userId so pushes are attributable per user for hosted cost accounting (a
// workspace fans out to every member's devices at emit time). The Expo token is
// the natural key: it is unique per app install and rotates when the install is
// reset, so we upsert on it and reassign ownership if a device is handed over to
// a different user. No email content is stored here.
model PushDevice {
  id            String         @id @default(cuid())
  userId        String
  expoPushToken String         @unique
  platform      DevicePlatform
  // Bumped on every re-registration; lets a future reaper prune tokens that
  // Expo reports as DeviceNotRegistered or that have gone silent for too long.
  lastSeenAt    DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Records that a user has connected the browser side-panel extension at least
// once. Per-user (an extension belongs to a user, like a PushDevice), and the
// presence of the row is the "does this user have the extension?" signal that
// suppresses the install nudge. Unique on userId: we only need the boolean, so a
// re-register from either browser just refreshes browser/version/lastSeenAt. No
// email content is stored here.
model ExtensionInstall {
  id         String           @id @default(cuid())
  userId     String           @unique
  browser    ExtensionBrowser
  version    String
  lastSeenAt DateTime         @default(now())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A connected mailbox and its encrypted OAuth grant, for any read-only provider
// (Gmail today, Outlook next). Provider-neutral: `provider` discriminates which
// adapter reads it; `emailAddress`/`subjectId`/`watchExpiresAt` carry the same
// meaning for every provider. One connection per workspace for now
// (`workspaceId @unique`); simultaneous multi-provider connections relax this to
// `@@unique([workspaceId, provider])` when the Outlook adapter lands.
model EmailConnection {
  id                    String           @id @default(cuid())
  workspaceId           String           @unique
  provider              Provider         @default(GMAIL)
  subjectId             String?
  emailAddress          String
  encryptedRefreshToken String
  grantedScopes         String[]
  status                ConnectionStatus @default(ACTIVE)
  lastVerifiedAt        DateTime?
  watchExpiresAt        DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model GmailSyncSettings {
  id                      String   @id @default(cuid())
  workspaceId             String   @unique
  includeSpam             Boolean  @default(false)
  includePromotions       Boolean  @default(false)
  sortingPaused           Boolean  @default(false)
  // When true, threads detected as automated/bulk are auto-filed to the
  // taxonomy's catch-all folder without invoking the LLM.
  routeBulkToOther        Boolean  @default(true)
  blacklistedSenderEmails String[] @default([])
  // Mirror taxonomy folders into the mailbox as Gmail labels / Outlook
  // categories and keep them in sync as threads are sorted. ON by default
  // (product decision: the write scope is granted upfront at connect when the
  // feature flag is enabled); users can switch it off per workspace. Inert
  // without the write scope (gmail.modify / Mail.ReadWrite) on the connection.
  labelWritebackEnabled   Boolean  @default(true)
  // Whether the browser extension injects its thread-summary card into the
  // native Gmail/Outlook UI for this workspace. On by default (the point of
  // shipping the content scripts); the extension itself has no toggle, so this
  // workspace setting is the only way to turn it off.
  threadSummaryInjectionEnabled Boolean @default(true)
  // Whether the browser extension injects its "Amarnai Reply" draft button into
  // the native Gmail/Outlook compose for this workspace. On by default. Kept
  // separate from the summary toggle: the surfaces are independently useful, and
  // drafting spends draft quota while reading a summary does not.
  replyButtonInjectionEnabled Boolean @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

// Per-workspace state for the auto-generate-taxonomy-from-inbox feature.
// Holds the latest generated proposal (awaiting user apply), the current job
// status, and the counters that drive the cost limiter (delta gate, cooldown,
// monthly backstop). One row per workspace.
enum TaxonomyGenerationStatus {
  IDLE
  RUNNING
  READY
  INSUFFICIENT
  FAILED
}

model TaxonomyGenerationState {
  id                     String                   @id @default(cuid())
  workspaceId            String                   @unique
  status                 TaxonomyGenerationStatus @default(IDLE)
  // The most recent generated TaxonomyTransferFile, awaiting user apply.
  // Null until the first READY result; cleared is not required (overwritten).
  proposal               Json?
  matchedTemplateId      String?
  // Last successful generation: timestamp + the eligible-thread count at that
  // time. Drives the delta gate (regenerate only after enough new signal).
  lastGeneratedAt        DateTime?
  threadCountAtLastGen   Int?
  // Outcome of the last completed run (SUCCESS | INSUFFICIENT | FAILED).
  // Distinct from `status`, which is the live job state. Drives the cooldown.
  lastOutcome            String?
  // Rolling 30-day backstop quota window.
  generationsWindowStart DateTime?
  generationsInWindow    Int                      @default(0)
  // Cost attribution for the generation LLM call.
  modelProvider          String?
  modelName              String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

// What a usage meter row counts. One meter family per cost driver.
enum MeterKind {
  THREAD_SORT
  DRAFT
  TAXONOMY_GEN
  BACKFILL
  THREAD_SUMMARY
}

// Reset-immune, inbox-keyed usage meter. Anti-abuse cost accounting lives here,
// NOT on workspace-owned rows: a workspace reset / delete wipes EmailClassification,
// Draft, ProviderSyncState, TaxonomyGenerationState — the rows the old per-tenant
// quotas counted — which refunded already-spent LLM cost. This table is keyed only
// on the normalized inbox address (see normalizeInboxKey) and has NO relation or FK
// to Workspace/GmailConnection, so no `onDelete: Cascade` and no `where: { workspaceId }`
// teardown can reach it. Usage is POOLED across every workspace/account that connects
// the same inbox, sized by the top plan among them. One row per (inboxKey, kind, window).
//
// IMPORTANT: do not add this model to any teardown in packages/db/src/workspace-ops.ts,
// and do not add a back-relation on Workspace/GmailConnection.
model InboxUsageMeter {
  id           String         @id @default(cuid())
  // Normalized inbox identity (NOT a workspace/user). The pooling key.
  inboxKey     String
  kind         MeterKind
  // Calendar-month UTC bucket start (getDraftQuotaWindowStart). BACKFILL uses the
  // same monthly bucket so budget + grace replenish monthly.
  windowStart  DateTime
  // Monotonic consumption counter for this window. Never decremented.
  used         Int            @default(0)
  // BACKFILL only: window-scoped grace flag. Once true, the 2x-cap grace ceiling is
  // unlocked for the rest of this window (so a multi-chunk re-import keeps its budget).
  // Eligibility to CLAIM grace is gated by the rolling 12-month graceClaimedAt lookback
  // below, not by this per-window flag.
  graceUsed    Boolean        @default(false)
  // BACKFILL only: when this window's grace token was claimed. Drives the rolling
  // 12-month grace gate — an inbox is grace-eligible only if NO BACKFILL row for its
  // inboxKey has graceClaimedAt within the last 365 days. Set atomically in the same
  // conditional update that flips graceUsed.
  graceClaimedAt DateTime?
  // Observability: the plan ceiling that first sized this window's budget.
  sizedForPlan WorkspacePlan?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([inboxKey, kind, windowStart])
  @@index([inboxKey, kind])
}

// BACKFILL only: records that a specific workspace has already been granted its
// one-time free import of this inbox. Distinguishes a genuinely-new sharing
// workspace (allowed one import from the pool) from a reset-and-redo of a workspace
// that already imported (which must draw from the shared grace token, not a fresh
// allowance). Keyed on (inboxKey, workspaceId) as plain Strings — no relation/FK —
// so it survives workspace reset, exactly like InboxUsageMeter.
model InboxBackfillGrant {
  id           String   @id @default(cuid())
  inboxKey     String
  // Attribution only — a plain String, NOT a relation (must survive reset).
  workspaceId  String
  // Threads consumed under this workspace's one-time free allowance.
  freeConsumed Int      @default(0)
  grantedAt    DateTime @default(now())

  @@unique([inboxKey, workspaceId])
  @@index([inboxKey])
}

// Reset-immune, no-FK idempotency ledger: one row per stable dedup token, claimed
// exactly once. This is the single mechanism that makes retried/duplicated worker
// jobs safe. It backs recordMeterUsage (a replay with the same token is a no-op
// instead of a second +1) and gates non-transactional side effects (the taxonomy
// proposal + meter, the lifecycle email send) so a crash-then-retry never
// double-charges a meter or repeats a side effect. Like InboxUsageMeter it has NO
// relation or FK to Workspace/User, so a reset/delete cannot erase a claim — a
// consumed unit of cost must never be refunded by tearing down its dedup marker.
//
// IMPORTANT: never add this model to a teardown in packages/db/src/workspace-ops.ts.
model IdempotencyMarker {
  id        String   @id @default(cuid())
  // Stable dedup token. Its shape varies by call site (threadId+window+source for a
  // thread sort, generation+cursor span for a backfill chunk, jobId for a taxonomy
  // generation or a lifecycle send) but it is ALWAYS globally unique, so a concurrent
  // or retried claim collapses in the DB (insert conflict), not in application logic.
  token     String   @unique
  createdAt DateTime @default(now())

  // The daily prune (pruneIdempotencyMarkers) deletes rows by createdAt; without
  // this index that DELETE seq-scans what is the highest-cardinality write table
  // (one row per metered unit of work).
  @@index([createdAt])
}

// Reset-immune record that an email identity (and optionally a payment card) has
// consumed the single 14-day free trial. Like InboxUsageMeter it has NO relation or
// FK to User/Workspace, so account deletion cannot erase it — that is the whole
// point: re-registering the same email must not mint a fresh trial. `emailKeyHash`
// is sha256(normalizeInboxKey(email)); the raw email is never stored (data-minimal
// for deleted accounts). `cardFingerprint` is nullable-unique so one card can start
// at most one trial, enforced atomically by the insert (Postgres allows many NULLs).
//
// IMPORTANT: never add this model to a teardown in packages/db/src/workspace-ops.ts
// as a delete. deleteUserCascade WRITES a claim on deletion; it must never remove one.
model TrialClaim {
  id                   String   @id @default(cuid())
  emailKeyHash         String   @unique
  cardFingerprint      String?  @unique
  // The subscription that consumed the trial; null for backfilled legacy rows.
  stripeSubscriptionId String?
  // Attribution only — a plain String, NOT a relation (must survive deletion).
  userId               String?
  createdAt            DateTime @default(now())
}

// Durable, no-FK retry record guaranteeing a deleted account's Stripe subscription
// is canceled even if Stripe was unreachable at deletion time — so nobody keeps
// paying for an account they deleted. The worker's tick reconciles each row against
// Stripe (retrieve-then-cancel) and deletes it once the subscription can no longer
// bill (canceled or gone). Attribution-only userId; the user row is usually already
// deleted by the time this retries.
model PendingSubscriptionCancellation {
  id                   String    @id @default(cuid())
  stripeSubscriptionId String    @unique
  userId               String?
  attempts             Int       @default(0)
  lastError            String?
  lastAttemptAt        DateTime?
  createdAt            DateTime  @default(now())
}
